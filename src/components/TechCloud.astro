---
import { t } from '../i18n';

const skills = [
  // AI Agent Skills
  { name: 'AI Agent', level: 5, icon: '🤖' },
  { name: 'Dify', level: 4, icon: '🔧' },
  { name: 'Context Engineering', level: 4, icon: '📝' },
  { name: 'Prompt Engineering', level: 4, icon: '💬' },
  { name: 'Tool Use', level: 4, icon: '🛠️' },
  { name: 'RAG', level: 3, icon: '📚' },
  { name: 'MCP', level: 3, icon: '🔌' },
  { name: 'Function Calling', level: 3, icon: '⚡' },

  // Data Engineering Skills
  { name: 'Airflow', level: 5, icon: '🌬️' },
  { name: 'LakeFS', level: 4, icon: '💾' },
  { name: 'Data Pipeline', level: 4, icon: '🔄' },
  { name: 'ETL/ELT', level: 4, icon: '📊' },
  { name: 'Spark', level: 3, icon: '✨' },
  { name: 'Data Versioning', level: 3, icon: '📦' },
  { name: 'Stream Processing', level: 3, icon: '🌊' },

  // Performance Skills
  { name: 'Performance Tuning', level: 4, icon: '🚀' },
  { name: 'E2E Optimization', level: 4, icon: '🎯' },
  { name: 'QPS/TPS', level: 3, icon: '📈' },

  // Tech Stack Skills
  { name: 'Python', level: 5, icon: '🐍' },
  { name: 'TypeScript', level: 4, icon: '📘' },
  { name: 'React', level: 4, icon: '⚛️' },
  { name: 'Docker', level: 3, icon: '🐳' },

  // Philosophy Skills
  { name: 'Open Source', level: 4, icon: '🌟' },
  { name: 'Automation First', level: 4, icon: '⚙️' },
  { name: 'Engineering Practices', level: 3, icon: '📐' },
];

// Level colors - Minecraft rarity style
const levelColors: Record<number, string> = {
  5: 'var(--accent-6)',   // Gold - Legendary
  4: 'var(--accent-3)',   // Diamond Blue - Epic
  3: 'var(--accent)',     // Green - Rare
};

// Level rarity keys (for i18n)
const rarityKeys: Record<number, string> = {
  5: 'legendary',
  4: 'epic',
  3: 'rare',
};
---

<div class="inventory-section">
  <div class="inventory-header">
    <span class="inventory-icon">📦</span>
    <span class="inventory-title" data-i18n="inventory.title">{t('zh', 'inventory.title')}</span>
    <button class="sort-btn" id="sortBtn" aria-label="Sort items">
      <span class="sort-icon">🔄</span>
    </button>
  </div>

  <div class="inventory-grid" id="inventoryGrid">
    {skills.map((skill, i) => (
      <div
        class="inventory-slot"
        data-level={skill.level}
        data-index={i}
        data-rarity-key={rarityKeys[skill.level]}
        style={`--delay: ${i * 0.03}s; --rarity-color: ${levelColors[skill.level]};`}
        tabindex="0"
      >
        <div class="item-container">
          <span class="item-icon">{skill.icon}</span>
          <span class="item-count">{skill.level}</span>
        </div>
        <span class="item-name">{skill.name}</span>

        <!-- Tooltip -->
        <div class="item-tooltip">
          <div class="tooltip-header">
            <span class="tooltip-icon">{skill.icon}</span>
            <span class="tooltip-name">{skill.name}</span>
          </div>
          <div class="tooltip-rarity" data-i18n={`inventory.${rarityKeys[skill.level]}`} style={`color: ${levelColors[skill.level]}`}>
            {t('zh', `inventory.${rarityKeys[skill.level]}`)}
          </div>
          <div class="tooltip-stats">
            <span class="stat-line" data-attack>⚔️ {t('zh', 'inventory.attack')} +{skill.level * 5}</span>
            <span class="stat-line" data-defense>🛡️ {t('zh', 'inventory.defense')} +{skill.level * 2}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .inventory-section {
    padding: 0.75rem 0;
  }

  .inventory-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.5rem;
    background: var(--surface);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light);
  }

  .inventory-icon {
    font-size: 1.25rem;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
  }

  .inventory-title {
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.55rem;
    color: var(--text-primary);
    flex: 1;
  }

  .sort-btn {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light);
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s step-end;
  }

  .sort-btn:hover {
    color: var(--accent);
    transform: translate(-1px, -1px);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light),
      3px 3px 0 var(--accent);
  }

  .sort-btn:active {
    transform: translate(1px, 1px);
  }

  .sort-icon {
    font-size: 0.9rem;
    transition: transform 0.3s;
  }

  .sort-btn:hover .sort-icon {
    transform: rotate(180deg);
  }

  /* Inventory Grid */
  .inventory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.5rem;
  }

  /* Inventory Slot - Minecraft style */
  .inventory-slot {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    background: var(--surface);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light);
    cursor: pointer;
    transition: all 0.15s step-end;
    animation: slotFadeIn 0.4s steps(4) forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  @keyframes slotFadeIn {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .inventory-slot:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light),
      4px 4px 0 var(--rarity-color);
    z-index: 10;
  }

  .inventory-slot:focus {
    outline: none;
    box-shadow:
      inset -3px 0 0 var(--rarity-color),
      inset 0 -3px 0 var(--rarity-color),
      inset 3px 0 0 var(--rarity-color),
      inset 0 3px 0 var(--rarity-color);
  }

  /* Item Container */
  .item-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .item-icon {
    font-size: 1.5rem;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
    line-height: 1;
  }

  .item-count {
    position: absolute;
    bottom: -4px;
    right: -4px;
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.4rem;
    color: var(--text-primary);
    background: var(--bg);
    padding: 0 3px;
    box-shadow:
      inset -1px 0 0 var(--block-shadow),
      inset 0 -1px 0 var(--block-shadow),
      inset 1px 0 0 var(--block-light),
      inset 0 1px 0 var(--block-light);
  }

  .item-name {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-align: center;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 0.25rem;
  }

  /* Tooltip - Minecraft style */
  .item-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 150px;
    background: #1a0a30;
    border: 2px solid #250a50;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    z-index: 100;
    pointer-events: none;
    box-shadow:
      inset -2px 0 0 rgba(0,0,0,0.5),
      inset 0 -2px 0 rgba(0,0,0,0.5),
      inset 2px 0 0 rgba(100,50,150,0.3),
      inset 0 2px 0 rgba(100,50,150,0.3);
  }

  .inventory-slot:hover .item-tooltip,
  .inventory-slot:focus .item-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .tooltip-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
  }

  .tooltip-icon {
    font-size: 1rem;
  }

  .tooltip-name {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .tooltip-rarity {
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .tooltip-stats {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 0.25rem;
    border-top: 1px solid #250a50;
  }

  .stat-line {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 0.75rem;
    color: #55ff55;
  }

  /* Rarity glow effect */
  .inventory-slot[data-level="5"] .item-icon {
    filter: drop-shadow(0 0 4px var(--accent-6)) drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
    animation: legendaryGlow 2s ease-in-out infinite;
  }

  @keyframes legendaryGlow {
    0%, 100% { filter: drop-shadow(0 0 4px var(--accent-6)) drop-shadow(2px 2px 0 rgba(0,0,0,0.3)); }
    50% { filter: drop-shadow(0 0 8px var(--accent-6)) drop-shadow(2px 2px 0 rgba(0,0,0,0.3)); }
  }

  .inventory-slot[data-level="4"] .item-icon {
    filter: drop-shadow(0 0 2px var(--accent-3)) drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
  }

  /* Responsive */
  @media (max-width: 640px) {
    .inventory-grid {
      grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    }

    .item-icon {
      font-size: 1.25rem;
    }

    .item-name {
      font-size: 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .inventory-grid {
      grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    }

    .item-tooltip {
      display: none;
    }

    .item-name {
      font-size: 0.55rem;
    }
  }
</style>

<script>
  // Sort functionality for inventory
  const grid = document.getElementById('inventoryGrid');
  const sortBtn = document.getElementById('sortBtn');

  if (grid && sortBtn) {
    let sortMode = 0;
    const sortModes = ['original', 'level-desc', 'level-asc', 'alpha', 'random'];
    let originalOrder: HTMLElement[] = [];

    document.addEventListener('DOMContentLoaded', () => {
      originalOrder = Array.from(grid.querySelectorAll('.inventory-slot')) as HTMLElement[];
    });

    sortBtn.addEventListener('click', () => {
      const slots = Array.from(grid.querySelectorAll('.inventory-slot')) as HTMLElement[];

      // Animate out
      slots.forEach((slot) => {
        slot.style.transform = 'scale(0.8)';
        slot.style.opacity = '0';
      });

      setTimeout(() => {
        sortMode = (sortMode + 1) % sortModes.length;
        let sorted = [...slots];

        switch (sortModes[sortMode]) {
          case 'original':
            sorted = [...originalOrder];
            break;
          case 'level-desc':
            sorted.sort((a, b) =>
              parseInt(b.getAttribute('data-level') || '0') -
              parseInt(a.getAttribute('data-level') || '0')
            );
            break;
          case 'level-asc':
            sorted.sort((a, b) =>
              parseInt(a.getAttribute('data-level') || '0') -
              parseInt(b.getAttribute('data-level') || '0')
            );
            break;
          case 'alpha':
            sorted.sort((a, b) => {
              const nameA = a.querySelector('.item-name')?.textContent || '';
              const nameB = b.querySelector('.item-name')?.textContent || '';
              return nameA.localeCompare(nameB);
            });
            break;
          case 'random':
            for (let i = sorted.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [sorted[i], sorted[j]] = [sorted[j], sorted[i]];
            }
            break;
        }

        // Re-append
        sorted.forEach(slot => grid.appendChild(slot));

        // Animate in with new animation
        sorted.forEach((slot, i) => {
          slot.style.animation = 'none';
          slot.offsetHeight; // Trigger reflow
          slot.style.animation = `slotFadeIn 0.4s steps(4) forwards ${i * 0.02}s`;
        });
      }, 200);
    });
  }

  // Update tooltips on language change
  function updateInventoryText(lang: string) {
    if (!window.__I18N__) return;
    const { t } = window.__I18N__;

    // Update rarity text
    document.querySelectorAll('.tooltip-rarity[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key) el.textContent = t(lang, key);
    });

    // Update attack/defense text
    document.querySelectorAll('.stat-line[data-attack]').forEach(el => {
      const slot = el.closest('.inventory-slot');
      const level = slot?.getAttribute('data-level') || '0';
      el.textContent = `⚔️ ${t(lang, 'inventory.attack')} +${parseInt(level) * 5}`;
    });

    document.querySelectorAll('.stat-line[data-defense]').forEach(el => {
      const slot = el.closest('.inventory-slot');
      const level = slot?.getAttribute('data-level') || '0';
      el.textContent = `🛡️ ${t(lang, 'inventory.defense')} +${parseInt(level) * 2}`;
    });
  }

  // Listen for language change
  window.addEventListener('langChange', (e: CustomEvent) => {
    updateInventoryText(e.detail.lang);
  });
</script>
