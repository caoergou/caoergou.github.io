---
const techs = [
  // AI Agent
  { name: 'AI Agent', weight: 5 },
  { name: 'Dify', weight: 4 },
  { name: 'Context Engineering', weight: 4 },
  { name: 'Prompt Engineering', weight: 4 },
  { name: 'Tool Use', weight: 4 },
  { name: 'RAG', weight: 3 },
  { name: 'MCP', weight: 3 },
  // Data Engineering
  { name: 'Airflow', weight: 5 },
  { name: 'LakeFS', weight: 4 },
  { name: 'Data Pipeline', weight: 4 },
  { name: 'ETL/ELT', weight: 4 },
  { name: 'Spark', weight: 3 },
  { name: 'Data Versioning', weight: 3 },
  { name: 'Stream Processing', weight: 3 },

  // Performance
  { name: 'Performance Tuning', weight: 4 },
  { name: 'End-to-End Optimization', weight: 4 },
  { name: 'QPS/TPS', weight: 3 },

  // Tech Stack
  { name: 'Python', weight: 5 },
  { name: 'TypeScript', weight: 4 },
  { name: 'React', weight: 4 },
  { name: 'Docker', weight: 3 },

  // Philosophy
  { name: 'Open Source', weight: 4 },
  { name: 'Automation First', weight: 4 },
  { name: 'Engineering Practices', weight: 3 },
];

const colors = ['var(--accent)', 'var(--accent-secondary)'];
---

<div class="tech-cloud-wrapper">
  <div class="tech-cloud" id="techCloud">
    {techs.map((tech, i) => (
      <span
        class="tech-tag"
        data-weight={tech.weight}
        data-index={i}
        style={`--delay: ${i * 0.03}s; --color: ${colors[i % 3]};`}
      >
        {tech.name}
      </span>
    ))}
  </div>
  <button class="zelda-sort-btn" id="shuffleBtn" aria-label="Sort skills">
    <span class="sort-gem">◆</span>
    <span class="sort-label">SORT</span>
    <span class="sort-mode-name" id="sortModeName">ORIGINAL</span>
    <span class="sort-cursor">▼</span>
  </button>
</div>

<style>
  .tech-cloud-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .tech-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: flex-start;
    padding: 0.5rem 0;
    position: relative;
    min-height: 80px;
    flex: 1;
  }

  /* ===== Clean Sort Button ===== */
  .zelda-sort-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.5rem 0.6rem;
    min-width: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .zelda-sort-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sort-gem {
    font-size: 0.9rem;
    display: block;
  }

  .sort-label {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.25rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .sort-mode-name {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.25rem;
    color: var(--accent-secondary);
    letter-spacing: 0.05em;
    text-align: center;
    line-height: 1.5;
    white-space: pre-line;
  }

  .sort-cursor {
    font-size: 0.4rem;
    color: var(--text-muted);
  }

  .tech-tag {
    display: inline-block;
    font-family: 'VT323', monospace;
    font-weight: 400;
    color: var(--color);
    padding: 0.25rem 0.6rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: default;
    transition: all var(--transition-fast);
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
    animation-delay: var(--delay);
    white-space: nowrap;
  }

  .tech-tag[data-weight="5"] { font-size: 1.1rem; }
  .tech-tag[data-weight="4"] { font-size: 0.95rem; }
  .tech-tag[data-weight="3"] { font-size: 0.85rem; }

  .tech-tag:hover {
    background: var(--surface);
    border-color: var(--color);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .tech-tag[data-weight="5"] { font-size: 1rem; }
    .tech-tag[data-weight="4"] { font-size: 0.9rem; }
    .tech-tag[data-weight="3"] { font-size: 0.8rem; }
  }
</style>

<script>
  // Zelda crystal sort — cycles through sort modes on click
  const cloud = document.getElementById('techCloud');
  const shuffleBtn = document.getElementById('shuffleBtn');
  const sortModeEl = document.getElementById('sortModeName');

  if (cloud && shuffleBtn) {
    let sortMode = 0;
    const sortModes = ['original', 'length-asc', 'length-desc', 'weight', 'alpha', 'random'];
    // Zelda-flavored mode labels (two lines via \n)
    const sortModeNames = ['ORIGINAL', 'SHORT\n▲', 'LONG\n▼', 'BY\nPOWER', 'A→Z\nORDER', 'CHAOS\nMODE!'];
    let originalOrder: HTMLElement[] = [];

    // Store original order on load
    document.addEventListener('DOMContentLoaded', () => {
      originalOrder = Array.from(cloud.querySelectorAll('.tech-tag')) as HTMLElement[];
    });

    shuffleBtn.addEventListener('click', () => {
      const tags = Array.from(cloud.querySelectorAll('.tech-tag')) as HTMLElement[];

      // Animate all tags out (pixel-step style)
      tags.forEach((tag) => {
        tag.style.transition = 'all 0.15s step-end';
        tag.style.transform = 'translateY(-16px)';
        tag.style.opacity = '0';
      });

      // Button press feedback
      (shuffleBtn as HTMLElement).style.transform = 'translate(2px, 2px)';
      setTimeout(() => {
        (shuffleBtn as HTMLElement).style.transform = '';
      }, 150);

      setTimeout(() => {
        // Advance sort mode
        sortMode = (sortMode + 1) % sortModes.length;
        let sorted = [...tags];

        switch (sortModes[sortMode]) {
          case 'original':
            sorted = [...originalOrder];
            break;
          case 'length-asc':
            sorted.sort((a, b) => (a.textContent?.length || 0) - (b.textContent?.length || 0));
            break;
          case 'length-desc':
            sorted.sort((a, b) => (b.textContent?.length || 0) - (a.textContent?.length || 0));
            break;
          case 'weight':
            sorted.sort((a, b) => parseInt(b.getAttribute('data-weight') || '0') - parseInt(a.getAttribute('data-weight') || '0'));
            break;
          case 'alpha':
            sorted.sort((a, b) => (a.textContent || '').localeCompare(b.textContent || ''));
            break;
          case 'random':
            for (let i = sorted.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [sorted[i], sorted[j]] = [sorted[j], sorted[i]];
            }
            break;
        }

        // Update mode label
        if (sortModeEl) sortModeEl.textContent = sortModeNames[sortMode];

        // Re-append in new order
        sorted.forEach(tag => cloud.appendChild(tag));

        // Animate back in with pixel stagger
        sorted.forEach((tag, i) => {
          setTimeout(() => {
            tag.style.transform = 'translateY(0)';
            tag.style.opacity = '1';
          }, i * 20);
        });
      }, 150);
    });
  }
</script>
