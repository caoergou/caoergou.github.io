---
const skills = [
  // AI Agent Skills
  { name: 'AI Agent', level: 5, icon: '🤖' },
  { name: 'Dify', level: 4, icon: '🔧' },
  { name: 'Context Engineering', level: 4, icon: '📝' },
  { name: 'Prompt Engineering', level: 4, icon: '💬' },
  { name: 'Tool Use', level: 4, icon: '🛠️' },
  { name: 'RAG', level: 3, icon: '📚' },
  { name: 'MCP', level: 3, icon: '🔌' },
  { name: 'Function Calling', level: 3, icon: '⚡' },

  // Data Engineering Skills
  { name: 'Airflow', level: 5, icon: '🌬️' },
  { name: 'LakeFS', level: 4, icon: '💾' },
  { name: 'Data Pipeline', level: 4, icon: '🔄' },
  { name: 'ETL/ELT', level: 4, icon: '📊' },
  { name: 'Spark', level: 3, icon: '✨' },
  { name: 'Data Versioning', level: 3, icon: '📦' },
  { name: 'Stream Processing', level: 3, icon: '🌊' },

  // Performance Skills
  { name: 'Performance Tuning', level: 4, icon: '🚀' },
  { name: 'E2E Optimization', level: 4, icon: '🎯' },
  { name: 'QPS/TPS', level: 3, icon: '📈' },

  // Tech Stack Skills
  { name: 'Python', level: 5, icon: '🐍' },
  { name: 'TypeScript', level: 4, icon: '📘' },
  { name: 'React', level: 4, icon: '⚛️' },
  { name: 'Docker', level: 3, icon: '🐳' },

  // Philosophy Skills
  { name: 'Open Source', level: 4, icon: '🌟' },
  { name: 'Automation First', level: 4, icon: '⚙️' },
  { name: 'Engineering Practices', level: 3, icon: '📐' },
];

// Level colors
const levelColors: Record<number, string> = {
  5: 'var(--accent)',    // Gold - Master
  4: 'var(--accent-2)',  // Green - Expert
  3: 'var(--accent-3)',  // Blue - Skilled
};

// Level star count
const levelStars = (level: number) => '⭐'.repeat(level);
---

<div class="skills-section">
  <div class="skills-header">
    <span class="skills-icon">⚔️</span>
    <span class="skills-title" data-text-zh="解锁的能力" data-text-en="Unlocked Skills">解锁的能力</span>
    <button class="shuffle-btn" id="shuffleBtn" aria-label="Shuffle skills">
      <span class="shuffle-icon">🎲</span>
    </button>
  </div>

  <div class="skills-grid" id="skillsGrid">
    {skills.map((skill, i) => (
      <div
        class="skill-badge"
        data-level={skill.level}
        data-index={i}
        style={`--delay: ${i * 0.04}s; --color: ${levelColors[skill.level]};`}
      >
        <span class="skill-icon">{skill.icon}</span>
        <span class="skill-name">{skill.name}</span>
        <span class="skill-stars">{levelStars(skill.level)}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .skills-section {
    padding: 0.75rem 0;
  }

  .skills-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .skills-icon {
    font-size: 1.25rem;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
  }

  .skills-title {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.55rem;
    color: var(--text-primary);
    flex: 1;
  }

  .shuffle-btn {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    box-shadow:
      2px 0 0 var(--border),
      -2px 0 0 var(--border),
      0 2px 0 var(--border),
      0 -2px 0 var(--border);
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s step-end;
  }

  .shuffle-btn:hover {
    box-shadow:
      2px 0 0 var(--accent),
      -2px 0 0 var(--accent),
      0 2px 0 var(--accent),
      0 -2px 0 var(--accent);
  }

  .shuffle-btn:active {
    transform: translate(1px, 1px);
  }

  .shuffle-icon {
    font-size: 0.9rem;
    transition: transform 0.2s;
  }

  .shuffle-btn:hover .shuffle-icon {
    transform: rotate(180deg);
  }

  /* Skills Grid */
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Skill Badge */
  .skill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    background: var(--surface);
    box-shadow:
      3px 0 0 var(--border),
      -3px 0 0 var(--border),
      0 3px 0 var(--border),
      0 -3px 0 var(--border);
    cursor: default;
    transition: all 0.15s step-end;
    animation: badgeFadeIn 0.5s steps(6) forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  @keyframes badgeFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .skill-badge:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      5px 0 0 var(--color),
      -5px 0 0 var(--color),
      0 5px 0 var(--color),
      0 -5px 0 var(--color);
  }

  /* Level-based sizing */
  .skill-badge[data-level="5"] { }
  .skill-badge[data-level="4"] { opacity: 0.9; }
  .skill-badge[data-level="3"] { opacity: 0.8; }

  .skill-icon {
    font-size: 0.85rem;
    filter: drop-shadow(1px 1px 0 rgba(0,0,0,0.2));
    line-height: 1;
  }

  .skill-name {
    font-family: 'VT323', monospace;
    font-size: 1rem;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .skill-stars {
    font-size: 0.5rem;
    line-height: 1;
    filter: drop-shadow(0 0 2px var(--color));
  }

  /* Responsive */
  @media (max-width: 640px) {
    .skill-badge {
      padding: 0.35rem 0.5rem;
    }

    .skill-name {
      font-size: 0.9rem;
    }

    .skill-stars {
      font-size: 0.4rem;
    }
  }

  @media (max-width: 480px) {
    .skill-icon {
      display: none;
    }

    .skill-stars {
      display: none;
    }
  }
</style>

<script>
  // Shuffle functionality
  const grid = document.getElementById('skillsGrid');
  const shuffleBtn = document.getElementById('shuffleBtn');

  if (grid && shuffleBtn) {
    let sortMode = 0;
    const sortModes = ['original', 'level-desc', 'level-asc', 'alpha', 'random'];
    let originalOrder: HTMLElement[] = [];

    document.addEventListener('DOMContentLoaded', () => {
      originalOrder = Array.from(grid.querySelectorAll('.skill-badge')) as HTMLElement[];
    });

    shuffleBtn.addEventListener('click', () => {
      const badges = Array.from(grid.querySelectorAll('.skill-badge')) as HTMLElement[];

      // Animate out
      badges.forEach((badge) => {
        badge.style.transform = 'translateY(-8px) scale(0.9)';
        badge.style.opacity = '0';
      });

      setTimeout(() => {
        sortMode = (sortMode + 1) % sortModes.length;
        let sorted = [...badges];

        switch (sortModes[sortMode]) {
          case 'original':
            sorted = [...originalOrder];
            break;
          case 'level-desc':
            sorted.sort((a, b) =>
              parseInt(b.getAttribute('data-level') || '0') -
              parseInt(a.getAttribute('data-level') || '0')
            );
            break;
          case 'level-asc':
            sorted.sort((a, b) =>
              parseInt(a.getAttribute('data-level') || '0') -
              parseInt(b.getAttribute('data-level') || '0')
            );
            break;
          case 'alpha':
            sorted.sort((a, b) => {
              const nameA = a.querySelector('.skill-name')?.textContent || '';
              const nameB = b.querySelector('.skill-name')?.textContent || '';
              return nameA.localeCompare(nameB);
            });
            break;
          case 'random':
            for (let i = sorted.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [sorted[i], sorted[j]] = [sorted[j], sorted[i]];
            }
            break;
        }

        // Re-append
        sorted.forEach(badge => grid.appendChild(badge));

        // Animate in
        sorted.forEach((badge, i) => {
          setTimeout(() => {
            badge.style.transform = 'translateY(0) scale(1)';
            badge.style.opacity = badge.getAttribute('data-level') === '5' ? '1' :
                                   badge.getAttribute('data-level') === '4' ? '0.9' : '0.8';
          }, i * 20);
        });
      }, 200);
    });
  }
</script>
