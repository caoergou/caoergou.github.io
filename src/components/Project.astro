---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Extract repo name from URL for live star fetching
const repoName = project.data.url?.split('github.com/')[1] || '';
---

<article class="project" data-type={project.data.type} data-repo={repoName}>
  <div class="project-header">
    {project.data.url ? (
      <a href={project.data.url} class="project-name" target="_blank" rel="noopener">
        {project.data.title}
      </a>
    ) : (
      <h3 class="project-name">{project.data.title}</h3>
    )}
    <span class="project-stars" data-stars={project.data.stars || 0}>
      ★ {project.data.stars || 0}
    </span>
  </div>
  {project.data.demo_url && (
    <div class="project-links">
      <a href={project.data.demo_url} class="project-demo-link" target="_blank" rel="noopener" data-link-zh="在线体验" data-link-en="Live Demo">
        在线体验
      </a>
    </div>
  )}
  <p class="project-desc" data-desc-zh={project.data.desc_zh} data-desc-en={project.data.desc_en}>{project.data.desc_zh}</p>
  <div class="project-tags">
    {project.data.tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
</article>

<script>
  // Fetch live star counts — parallel requests, session cache to avoid repeat fetches
  document.addEventListener('DOMContentLoaded', () => {
    const projects = Array.from(document.querySelectorAll('.project[data-repo]'));
    const CACHE_KEY_PREFIX = 'gh_stars_';
    const CACHE_TTL = 1000 * 60 * 30; // 30 minutes

    const updateStar = (starEl: Element, stars: number) => {
      starEl.setAttribute('data-stars', String(stars));
      starEl.textContent = stars >= 1000 ? `★ ${(stars / 1000).toFixed(1)}k` : `★ ${stars}`;
      starEl.classList.add('loaded');
    };

    const fetchRepo = async (repo: string): Promise<number | null> => {
      const cacheKey = CACHE_KEY_PREFIX + repo;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const { stars, ts } = JSON.parse(cached);
          if (Date.now() - ts < CACHE_TTL) return stars;
        }
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (!res.ok) return null;
        const { stargazers_count } = await res.json();
        sessionStorage.setItem(cacheKey, JSON.stringify({ stars: stargazers_count, ts: Date.now() }));
        return stargazers_count;
      } catch {
        return null;
      }
    };

    // Fire all requests in parallel
    Promise.all(
      projects.map(async (project) => {
        const repo = project.getAttribute('data-repo');
        if (!repo) return;
        const starEl = project.querySelector('.project-stars');
        if (!starEl) return;
        const stars = await fetchRepo(repo);
        if (stars !== null) updateStar(starEl, stars);
      })
    );
  });
</script>

<style>
  .project {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    transition: all 0.3s ease;
    position: relative;
    cursor: pointer;
  }

  .project:hover {
    border-left-color: var(--accent);
    background: var(--bg-secondary);
    transform: translateX(4px);
    box-shadow: -4px 0 20px var(--accent-glow);
  }

  .project-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
    cursor: pointer;
    letter-spacing: -0.02em;
  }

  .project-name:hover {
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent-glow);
  }

  .project-stars {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    white-space: nowrap;
    font-weight: 700;
    text-shadow: 0 0 10px var(--accent-glow);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .project-stars.loaded {
    opacity: 1;
    animation: starPop 0.3s ease;
  }

  @keyframes starPop {
    0% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .project-stars::before {
    content: '★ ';
  }

  .project-links {
    margin-bottom: 0.25rem;
  }

  .project-demo-link {
    font-size: 0.7rem;
    color: var(--accent-3);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .project-demo-link:hover {
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent-glow);
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.65rem;
    padding: 0.2rem 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-weight: 600;
    font-family: 'Space Grotesk', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  @media (max-width: 640px) {
    .project {
      padding: 1rem;
    }
    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Linked vs Personal project visual distinction */
  .project[data-type="linked"] {
    border-left-color: var(--accent-3);
  }

  .project[data-type="linked"]:hover {
    border-left-color: var(--accent-3);
    box-shadow: -4px 0 20px rgba(0, 212, 255, 0.2);
  }

  .project[data-type="personal"] {
    border-left-color: var(--accent-2);
  }

  .project[data-type="personal"]:hover {
    border-left-color: var(--accent-2);
    box-shadow: -4px 0 20px rgba(255, 0, 102, 0.2);
  }
</style>
