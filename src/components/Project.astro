---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Region icon by project type (dungeon room theme)
const typeIcons: Record<string, string> = {
  linked: '🏰',
  personal: '⚔️',
  os: '🗝️',
};
const regionIcon = typeIcons[project.data.type] || '🏛';

// Extract repo name from URL for live star fetching
const repoName = project.data.url?.split('github.com/')[1] || '';
---

<article class="project" data-type={project.data.type} data-repo={repoName}>
  <div class="project-header">
    <div class="project-title-row">
      <span class="region-icon">{regionIcon}</span>
      {project.data.url ? (
        <a href={project.data.url} class="project-name" target="_blank" rel="noopener">
          {project.data.title}
        </a>
      ) : (
        <h3 class="project-name">{project.data.title}</h3>
      )}
    </div>
    <span class="project-stars" data-stars={project.data.stars || 0}>
      ★ {project.data.stars || 0}
    </span>
  </div>
  {project.data.demo_url && (
    <div class="project-links">
      <a href={project.data.demo_url} class="project-demo-link" target="_blank" rel="noopener" data-link-zh="在线体验" data-link-en="Live Demo">
        在线体验
      </a>
    </div>
  )}
  <p class="project-desc" data-desc-zh={project.data.desc_zh} data-desc-en={project.data.desc_en}>{project.data.desc_zh}</p>
  <div class="project-tags">
    {project.data.tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
</article>

<script>
  // Fetch live star counts — parallel requests, session cache to avoid repeat fetches
  document.addEventListener('DOMContentLoaded', () => {
    const projects = Array.from(document.querySelectorAll('.project[data-repo]'));
    const CACHE_KEY_PREFIX = 'gh_stars_';
    const CACHE_TTL = 1000 * 60 * 30; // 30 minutes

    const updateStar = (starEl: Element, stars: number) => {
      starEl.setAttribute('data-stars', String(stars));
      starEl.textContent = stars >= 1000 ? `★ ${(stars / 1000).toFixed(1)}k` : `★ ${stars}`;
      starEl.classList.add('loaded');
    };

    const fetchRepo = async (repo: string): Promise<number | null> => {
      const cacheKey = CACHE_KEY_PREFIX + repo;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const { stars, ts } = JSON.parse(cached);
          if (Date.now() - ts < CACHE_TTL) return stars;
        }
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (!res.ok) return null;
        const { stargazers_count } = await res.json();
        sessionStorage.setItem(cacheKey, JSON.stringify({ stars: stargazers_count, ts: Date.now() }));
        return stargazers_count;
      } catch {
        return null;
      }
    };

    // Fire all requests in parallel
    Promise.all(
      projects.map(async (project) => {
        const repo = project.getAttribute('data-repo');
        if (!repo) return;
        const starEl = project.querySelector('.project-stars');
        if (!starEl) return;
        const stars = await fetchRepo(repo);
        if (stars !== null) updateStar(starEl, stars);
      })
    );
  });
</script>

<style>
  /* ===== Clean Project Card Style ===== */
  .project {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    position: relative;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .project:hover {
    background: var(--surface-alt);
    border-color: var(--accent);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .region-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .project:hover .region-icon {
    transform: scale(1.1);
  }

  .project-name {
    font-family: 'VT323', monospace;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
    cursor: pointer;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .project-name:hover {
    color: var(--accent);
  }

  .project-stars {
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
    padding: 0.15rem 0.4rem;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .project-stars.loaded {
    opacity: 1;
  }

  .project-links {
    margin-bottom: 0.1rem;
  }

  .project-demo-link {
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--accent-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--accent-secondary);
    border-radius: 4px;
    transition: all var(--transition-fast);
    display: inline-block;
  }

  .project-demo-link:hover {
    color: var(--bg);
    background: var(--accent-secondary);
  }

  .project-desc {
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  /* Clean minimal tags */
  .tag {
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    text-transform: lowercase;
    transition: all var(--transition-fast);
  }

  .tag:hover {
    color: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  @media (max-width: 640px) {
    .project {
      padding: 0.875rem 1rem;
    }
    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .project-name {
      font-size: 1.1rem;
    }
  }
</style>
