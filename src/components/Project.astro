---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Region icon by project type (dungeon room theme)
const typeIcons: Record<string, string> = {
  linked: '🏰',
  personal: '⚔️',
  os: '🗝️',
};
const regionIcon = typeIcons[project.data.type] || '🏛';

// Extract repo name from URL for live star fetching
const repoName = project.data.url?.split('github.com/')[1] || '';
---

<article class="project" data-type={project.data.type} data-repo={repoName}>
  <div class="project-header">
    <div class="project-title-row">
      <span class="region-icon">{regionIcon}</span>
      {project.data.url ? (
        <a href={project.data.url} class="project-name" target="_blank" rel="noopener">
          {project.data.title}
        </a>
      ) : (
        <h3 class="project-name">{project.data.title}</h3>
      )}
    </div>
    <span class="project-stars" data-stars={project.data.stars || 0}>
      ★ {project.data.stars || 0}
    </span>
  </div>
  {project.data.demo_url && (
    <div class="project-links">
      <a href={project.data.demo_url} class="project-demo-link" target="_blank" rel="noopener" data-link-zh="在线体验" data-link-en="Live Demo">
        在线体验
      </a>
    </div>
  )}
  <p class="project-desc" data-desc-zh={project.data.desc_zh} data-desc-en={project.data.desc_en}>{project.data.desc_zh}</p>
  <div class="project-tags">
    {project.data.tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
</article>

<script>
  // Fetch live star counts — parallel requests, session cache to avoid repeat fetches
  document.addEventListener('DOMContentLoaded', () => {
    const projects = Array.from(document.querySelectorAll('.project[data-repo]'));
    const CACHE_KEY_PREFIX = 'gh_stars_';
    const CACHE_TTL = 1000 * 60 * 30; // 30 minutes

    const updateStar = (starEl: Element, stars: number) => {
      starEl.setAttribute('data-stars', String(stars));
      starEl.textContent = stars >= 1000 ? `★ ${(stars / 1000).toFixed(1)}k` : `★ ${stars}`;
      starEl.classList.add('loaded');
    };

    const fetchRepo = async (repo: string): Promise<number | null> => {
      const cacheKey = CACHE_KEY_PREFIX + repo;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const { stars, ts } = JSON.parse(cached);
          if (Date.now() - ts < CACHE_TTL) return stars;
        }
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (!res.ok) return null;
        const { stargazers_count } = await res.json();
        sessionStorage.setItem(cacheKey, JSON.stringify({ stars: stargazers_count, ts: Date.now() }));
        return stargazers_count;
      } catch {
        return null;
      }
    };

    // Fire all requests in parallel
    Promise.all(
      projects.map(async (project) => {
        const repo = project.getAttribute('data-repo');
        if (!repo) return;
        const starEl = project.querySelector('.project-stars');
        if (!starEl) return;
        const stars = await fetchRepo(repo);
        if (stars !== null) updateStar(starEl, stars);
      })
    );
  });
</script>

<style>
  /* ===== Zelda Dungeon Room Style ===== */
  .project {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
    margin-bottom: 0.5rem;
    background: var(--surface);
    box-shadow:
      4px 0 0 var(--border),
      -4px 0 0 var(--border),
      0 4px 0 var(--border),
      0 -4px 0 var(--border);
    position: relative;
    cursor: pointer;
    transition: all 0.15s step-end;
  }

  .project:hover {
    transform: translate(-2px, -2px);
    background: var(--bg-secondary);
    box-shadow:
      6px 0 0 var(--accent),
      -6px 0 0 var(--accent),
      0 6px 0 var(--accent),
      0 -6px 0 var(--accent);
  }

  .project:active {
    transform: translate(2px, 2px);
    box-shadow:
      2px 0 0 var(--accent),
      -2px 0 0 var(--accent),
      0 2px 0 var(--accent),
      0 -2px 0 var(--accent);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .region-icon {
    font-size: 1rem;
    flex-shrink: 0;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
    transition: transform 0.15s step-end;
  }

  .project:hover .region-icon {
    transform: scale(1.2);
  }

  .project-name {
    font-family: 'VT323', monospace;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s step-end;
    cursor: pointer;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .project-name:hover {
    color: var(--accent);
  }

  .project-stars {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.45rem;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.15s step-end;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 217, 61, 0.08);
    box-shadow:
      2px 0 0 var(--border),
      -2px 0 0 var(--border),
      0 2px 0 var(--border),
      0 -2px 0 var(--border);
  }

  .project-stars.loaded {
    opacity: 1;
    animation: starPop 0.15s step-end;
  }

  @keyframes starPop {
    0% { transform: scale(1.3); color: var(--accent-2); }
    100% { transform: scale(1); color: var(--accent); }
  }

  .project-links {
    margin-bottom: 0.1rem;
  }

  .project-demo-link {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.4rem;
    color: var(--accent-3);
    text-decoration: none;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.6rem;
    box-shadow:
      2px 0 0 var(--accent-3),
      -2px 0 0 var(--accent-3),
      0 2px 0 var(--accent-3),
      0 -2px 0 var(--accent-3);
    transition: all 0.15s step-end;
    display: inline-block;
  }

  .project-demo-link:hover {
    color: var(--accent);
    box-shadow:
      2px 0 0 var(--accent),
      -2px 0 0 var(--accent),
      0 2px 0 var(--accent),
      0 -2px 0 var(--accent);
    transform: translate(-1px, -1px);
  }

  .project-desc {
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    padding-left: 0.25rem;
    border-left: 3px solid var(--border);
  }

  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  /* Inventory-style pixel tags */
  .tag {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.3rem;
    padding: 0.25rem 0.5rem;
    background: transparent;
    box-shadow:
      2px 0 0 var(--border),
      -2px 0 0 var(--border),
      0 2px 0 var(--border),
      0 -2px 0 var(--border);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.15s step-end;
  }

  .tag:hover {
    color: var(--accent-2);
    box-shadow:
      2px 0 0 var(--accent-2),
      -2px 0 0 var(--accent-2),
      0 2px 0 var(--accent-2),
      0 -2px 0 var(--accent-2);
  }

  @media (max-width: 640px) {
    .project {
      padding: 0.9rem 1rem;
    }
    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .project-name {
      font-size: 1.1rem;
    }
  }

  /* Type-specific accent colors on pixel border */
  .project[data-type="linked"]:hover {
    box-shadow:
      6px 0 0 var(--accent-3),
      -6px 0 0 var(--accent-3),
      0 6px 0 var(--accent-3),
      0 -6px 0 var(--accent-3);
  }

  .project[data-type="personal"]:hover {
    box-shadow:
      6px 0 0 var(--accent-2),
      -6px 0 0 var(--accent-2),
      0 6px 0 var(--accent-2),
      0 -6px 0 var(--accent-2);
  }

  .project[data-type="os"]:hover {
    box-shadow:
      6px 0 0 var(--accent-5),
      -6px 0 0 var(--accent-5),
      0 6px 0 var(--accent-5),
      0 -6px 0 var(--accent-5);
  }
</style>
