---
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';

interface Props {
  profile: CollectionEntry<'profile'>;
}

const { profile } = Astro.props;

// Calculate adventure days (from a start date, or estimate from work experience)
const adventureStartDate = new Date('2020-01-01'); // Example start date
const today = new Date();
const adventureDays = Math.floor((today.getTime() - adventureStartDate.getTime()) / (1000 * 60 * 60 * 24));

// Explorer stats
const stats = {
  regionsExplored: 5, // Number of projects
  skillsUnlocked: 12, // Number of tech skills
  adventureDays: adventureDays
};
---

<section class="hero">
  <!-- Top Controls: Language + Theme -->
  <div class="top-controls">
    <button id="langToggle" class="control-btn" aria-label="Switch language">
      <span class="lang-text" data-i18n="hero.langToggle">{t('zh', 'hero.langToggle')}</span>
    </button>
    <button id="themeToggle" class="control-btn theme-btn" aria-label="Toggle theme">
      <svg class="theme-icon dark" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"/>
        <circle cx="12" cy="12" r="4"/>
      </svg>
      <svg class="theme-icon light" viewBox="0 0 24 24" fill="currentColor">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>

  <!-- Adventurer Profile Card -->
  <div class="adventurer-card">
    <div class="avatar-frame">
      <div class="avatar-inner">
        <span class="avatar-icon">⚔️</span>
      </div>
      <div class="level-badge">Lv.{Math.floor(adventureDays / 365 * 10)}</div>
    </div>

    <div class="adventurer-info">
      <div class="name-row">
        <h1 class="hero-name">{profile.data.name}</h1>
        <a href="https://github.com/caoergou" target="_blank" rel="noopener" class="hero-username">@caoergou</a>
      </div>
      <div class="hero-title" data-i18n="hero.title">{t('zh', 'hero.title')}</div>
    </div>
  </div>

  <!-- Explorer Quote -->
  <blockquote class="hero-tagline" data-tagline-zh={profile.data.tagline.zh} data-tagline-en={profile.data.tagline.en}></blockquote>

  <!-- Adventure Stats -->
  <div class="hero-stats">
    <div class="stat">
      <span class="stat-icon">🗺️</span>
      <span class="stat-value">{stats.regionsExplored}</span>
      <span class="stat-label" data-i18n="stats.regions">{t('zh', 'stats.regions')}</span>
    </div>
    <div class="stat">
      <span class="stat-icon">⚔️</span>
      <span class="stat-value">{stats.skillsUnlocked}</span>
      <span class="stat-label" data-i18n="stats.skills">{t('zh', 'stats.skills')}</span>
    </div>
    <div class="stat">
      <span class="stat-icon">🌟</span>
      <span class="stat-value">{stats.adventureDays.toLocaleString()}+</span>
      <span class="stat-label" data-i18n="stats.days">{t('zh', 'stats.days')}</span>
    </div>
  </div>

  <!-- Social Links as Quick Actions -->
  <div class="hero-links">
    {profile.data.social_links.map((link) => (
      <a
        href={link.url}
        class="hero-link"
        target={link.url.startsWith('http') ? '_blank' : '_self'}
        rel={link.url.startsWith('http') ? 'noopener noreferrer' : ''}
      >
        <span class="link-icon">
          {link.icon === 'github' ? '🐙' : link.icon === 'jike' ? '💬' : link.icon === 'email' ? '📨' : '🔗'}
        </span>
        <span class="link-text">{link.name}</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* ===== Top Controls - Minecraft Block Style ===== */
  .top-controls {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 100;
    display: flex;
    gap: 0.5rem;
  }

  .control-btn {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: none;
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light),
      3px 3px 0 var(--block-shadow);
    color: var(--text-secondary);
    cursor: pointer;
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.5rem;
    transition: all 0.15s step-end;
  }

  .control-btn:hover {
    color: var(--accent);
    transform: translate(-2px, -2px);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light),
      5px 5px 0 var(--accent);
  }

  .control-btn:active {
    transform: translate(2px, 2px);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light),
      2px 2px 0 var(--block-shadow);
  }

  .lang-text {
    text-transform: uppercase;
  }

  .theme-icon {
    width: 16px;
    height: 16px;
  }

  .theme-icon.light {
    display: none;
  }

  :global(.light-mode) .theme-icon.dark {
    display: none;
  }

  :global(.light-mode) .theme-icon.light {
    display: block;
  }

  /* ===== Player Card - Minecraft Style ===== */
  .adventurer-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    padding: 1rem;
    background: var(--surface);
    box-shadow:
      inset -4px 0 0 var(--block-shadow),
      inset 0 -4px 0 var(--block-shadow),
      inset 4px 0 0 var(--block-light),
      inset 0 4px 0 var(--block-light),
      6px 6px 0 var(--block-shadow);
  }

  /* Minecraft-style Avatar */
  .avatar-frame {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-inner {
    width: 64px;
    height: 64px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0%,
      var(--accent) 25%,
      var(--accent-5) 25%,
      var(--accent-5) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset -3px 0 0 #8B4513,
      inset 0 -3px 0 #8B4513,
      inset 3px 0 0 #7CB342,
      inset 0 3px 0 #7CB342;
    position: relative;
    overflow: hidden;
    image-rendering: pixelated;
  }

  .avatar-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0px,
        transparent 8px,
        rgba(0,0,0,0.05) 8px,
        rgba(0,0,0,0.05) 16px
      );
  }

  .avatar-icon {
    font-size: 1.75rem;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
  }

  .level-badge {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-6);
    color: var(--bg);
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.4rem;
    padding: 2px 6px;
    box-shadow:
      inset -2px 0 0 rgba(0,0,0,0.3),
      inset 0 -2px 0 rgba(0,0,0,0.3),
      inset 2px 0 0 rgba(255,255,255,0.2),
      inset 0 2px 0 rgba(255,255,255,0.2);
    white-space: nowrap;
  }

  /* Name and Title */
  .adventurer-info {
    flex: 1;
    min-width: 0;
  }

  .name-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .hero-name {
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.3;
    color: var(--text-primary);
    text-shadow:
      3px 3px 0 var(--accent),
      -1px -1px 0 var(--border);
  }

  .hero-username {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 1rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.15rem 0.4rem;
    background: var(--surface-alt);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light);
    transition: all 0.15s step-end;
  }

  .hero-username:hover {
    color: var(--accent);
    transform: translate(-1px, -1px);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light),
      3px 3px 0 var(--accent);
  }

  .hero-title {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 1.1rem;
    color: var(--accent-3);
    letter-spacing: 0.05em;
  }

  /* ===== Hero Tagline ===== */
  .hero-tagline {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: clamp(1.1rem, 3vw, 1.3rem);
    color: var(--accent);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.5;
    max-width: 100%;
    border-left: 4px solid var(--accent);
    background: linear-gradient(90deg, rgba(93, 206, 46, 0.1) 0%, transparent 100%);
  }

  /* ===== Adventure Stats - Minecraft Stats Bar ===== */
  .hero-stats {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--surface);
    box-shadow:
      inset -4px 0 0 var(--block-shadow),
      inset 0 -4px 0 var(--block-shadow),
      inset 4px 0 0 var(--block-light),
      inset 0 4px 0 var(--block-light);
    margin-bottom: 1.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    flex: 1;
    padding: 0.5rem;
    background: var(--bg);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light);
  }

  .stat-icon {
    font-size: 1.25rem;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.2));
  }

  .stat-value {
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.8rem;
    color: var(--accent-6);
    text-shadow: 2px 2px 0 rgba(255, 170, 0, 0.2);
  }

  .stat-label {
    font-family: 'Zpix', 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* ===== Hero Links - Minecraft Inventory Slots ===== */
  .hero-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-primary);
    text-decoration: none;
    cursor: pointer;
    padding: 0.6rem 0.9rem;
    background: var(--surface);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light),
      4px 4px 0 var(--block-shadow);
    transition: all 0.15s step-end;
  }

  .hero-link:hover {
    transform: translate(-3px, -3px);
    box-shadow:
      inset -3px 0 0 var(--block-shadow),
      inset 0 -3px 0 var(--block-shadow),
      inset 3px 0 0 var(--block-light),
      inset 0 3px 0 var(--block-light),
      6px 6px 0 var(--accent);
  }

  .hero-link:active {
    transform: translate(2px, 2px);
    box-shadow:
      inset -2px 0 0 var(--block-shadow),
      inset 0 -2px 0 var(--block-shadow),
      inset 2px 0 0 var(--block-light),
      inset 0 2px 0 var(--block-light),
      2px 2px 0 var(--block-shadow);
  }

  .link-icon {
    font-size: 1rem;
    filter: drop-shadow(1px 1px 0 rgba(0,0,0,0.2));
  }

  .link-text {
    font-family: 'Zpix', 'Press Start 2P', cursive;
    font-size: 0.5rem;
    letter-spacing: 0.02em;
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .top-controls {
      top: 1rem;
      right: 1rem;
    }

    .adventurer-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 0.75rem;
    }

    .name-row {
      flex-direction: column;
      gap: 0.25rem;
    }

    .hero-stats {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .stat {
      min-width: 80px;
    }

    .hero-links {
      flex-direction: column;
    }

    .hero-link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .avatar-inner {
      width: 56px;
      height: 56px;
    }

    .hero-name {
      font-size: 1rem;
    }

    .stat-value {
      font-size: 0.65rem;
    }

    .stat-label {
      font-size: 0.75rem;
    }
  }
</style>

<script is:inline>
  // Update hero text on language change (uses global __I18N__ from BaseLayout)
  function updateHeroText(lang) {
    // Wait for __I18N__ to be available
    if (!window.__I18N__) return;

    const { t } = window.__I18N__;

    // Update tagline (from data attributes)
    const taglineEl = document.querySelector('[data-tagline-zh]');
    if (taglineEl) {
      taglineEl.textContent = taglineEl.getAttribute(`data-tagline-${lang}`) || '';
    }

    // Update elements with data-i18n
    document.querySelectorAll('.hero [data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const text = t(lang, key);
      if (text) el.textContent = text;
    });
  }

  // Listen for global language change event
  window.addEventListener('langChange', (e) => {
    updateHeroText(e.detail.lang);
  });

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    const lang = localStorage.getItem('lang') || 'zh';
    updateHeroText(lang);
  });

  // Language toggle
  const langToggle = document.getElementById('langToggle');
  langToggle.addEventListener('click', () => {
    const currentLang = localStorage.getItem('lang') || 'zh';
    const newLang = currentLang === 'zh' ? 'en' : 'zh';

    // Use global updateAllText if available
    if (window.__I18N__) {
      window.__I18N__.updateAllText(newLang);
    }
  });

  // Theme switching
  const themeToggle = document.getElementById('themeToggle');
  const root = document.documentElement;

  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'light') {
    root.classList.add('light-mode');
  }

  themeToggle.addEventListener('click', () => {
    root.classList.toggle('light-mode');
    const isLight = root.classList.contains('light-mode');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });
</script>
