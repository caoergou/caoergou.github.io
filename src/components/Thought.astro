---
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';

interface Props {
  thought: CollectionEntry<'thoughts'>;
}

const { thought } = Astro.props;

// Status icons for different exploration states
const statusIcons = ['🗼', '🔮', '🌟', '📚', '⚗️'];
// 用 slug 确定性选择图标，避免 SSR 水合不匹配
const slugHash = thought.slug.split('').reduce((acc: number, char: string) => acc + char.charCodeAt(0), 0);
const statusIcon = statusIcons[slugHash % statusIcons.length];
---

<article class="thought">
  <div class="thought-header">
    <span class="status-icon">{statusIcon}</span>
    <h3 class="thought-title" data-title-zh={thought.data.title.zh} data-title-en={thought.data.title.en}>{thought.data.title.zh}</h3>
  </div>
  <p class="thought-text" data-desc-zh={thought.data.description.zh} data-desc-en={thought.data.description.en}>{thought.data.description.zh}</p>
  <div class="thought-status">
    <span class="status-badge">
      <span class="status-dot"></span>
      <span data-i18n="thought.exploring">{t('zh', 'thought.exploring')}</span>
    </span>
  </div>
</article>

<style>
  .thought {
    padding: 1rem 1.25rem;
    margin-bottom: 0.5rem;
    background: var(--surface);
    box-shadow:
      4px 0 0 var(--accent-5),
      -4px 0 0 var(--accent-5),
      0 4px 0 var(--accent-5),
      0 -4px 0 var(--accent-5);
    position: relative;
    cursor: pointer;
    transition: all 0.15s step-end;
  }

  .thought:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      6px 0 0 var(--accent-5),
      -6px 0 0 var(--accent-5),
      0 6px 0 var(--accent-5),
      0 -6px 0 var(--accent-5);
  }

  .thought:active {
    transform: translate(2px, 2px);
    box-shadow:
      2px 0 0 var(--accent-5),
      -2px 0 0 var(--accent-5),
      0 2px 0 var(--accent-5),
      0 -2px 0 var(--accent-5);
  }

  /* Header */
  .thought-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .status-icon {
    font-size: 1.25rem;
    line-height: 1;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.3));
  }

  .thought-title {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.55rem;
    color: var(--accent-5);
    margin: 0;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  /* Text */
  .thought-text {
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    padding-left: 0.25rem;
    border-left: 3px solid var(--border);
  }

  /* Status */
  .thought-status {
    display: flex;
    justify-content: flex-end;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--accent-2);
    padding: 0.15rem 0.5rem;
    background: rgba(107, 203, 119, 0.1);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-2);
    animation: pulse 1.5s steps(2) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .thought {
      padding: 0.875rem 1rem;
    }

    .thought-title {
      font-size: 0.5rem;
    }

    .thought-text {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .thought-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>
