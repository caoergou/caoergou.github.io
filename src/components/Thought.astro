---
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';

interface Props {
  thought: CollectionEntry<'thoughts'>;
}

const { thought } = Astro.props;

// Status icons for different exploration states
const statusIcons = ['🗼', '🔮', '🌟', '📚', '⚗️'];
// 用 slug 确定性选择图标，避免 SSR 水合不匹配
const slugHash = thought.slug.split('').reduce((acc: number, char: string) => acc + char.charCodeAt(0), 0);
const statusIcon = statusIcons[slugHash % statusIcons.length];
---

<article class="thought">
  <div class="thought-header">
    <span class="status-icon">{statusIcon}</span>
    <h3 class="thought-title" data-title-zh={thought.data.title.zh} data-title-en={thought.data.title.en}>{thought.data.title.zh}</h3>
  </div>
  <p class="thought-text" data-desc-zh={thought.data.description.zh} data-desc-en={thought.data.description.en}>{thought.data.description.zh}</p>
  <div class="thought-status">
    <span class="status-badge">
      <span class="status-dot"></span>
      <span data-i18n="thought.exploring">{t('zh', 'thought.exploring')}</span>
    </span>
  </div>
</article>

<style>
  .thought {
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    position: relative;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .thought:hover {
    background: var(--surface-alt);
    border-color: var(--accent-secondary);
  }

  /* Header - Simplified */
  .thought-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .status-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .thought-title {
    font-family: 'VT323', monospace;
    font-size: 1.15rem;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  /* Text */
  .thought-text {
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 0.5rem 0;
  }

  /* Status */
  .thought-status {
    display: flex;
    justify-content: flex-end;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    color: var(--accent-secondary);
    padding: 0.1rem 0.4rem;
    background: rgba(16, 185, 129, 0.1);
    border-radius: 4px;
  }

  .status-dot {
    width: 5px;
    height: 5px;
    background: var(--accent-secondary);
    border-radius: 50%;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .thought {
      padding: 0.875rem 1rem;
    }

    .thought-title {
      font-size: 1.1rem;
    }

    .thought-text {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .thought-header {
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
    }
  }
</style>
