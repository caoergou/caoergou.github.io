---
interface Props {
  title: string;
  date: string;
  description?: string;
  slug?: string;
  lang?: 'zh' | 'en';
  hasAlternate?: boolean;
}

const { title, date, description, slug, lang = 'zh', hasAlternate = false } = Astro.props;

const siteUrl = 'https://eric.run.place';
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en-US';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const alternateLang = lang === 'zh' ? 'en' : 'zh';
const alternateHtmlLang = lang === 'zh' ? 'en-US' : 'zh-CN';
const canonicalUrl = slug ? `${siteUrl}/blog/${lang}/${slug}/` : `${siteUrl}/blog/`;
const alternateUrl = slug ? `${siteUrl}/blog/${alternateLang}/${slug}/` : undefined;
const ogImage = `${siteUrl}/og-image.png`;
const metaDescription = description || (lang === 'zh' ? `${title} - Eric Cao 的技术文章` : `${title} - Article by Eric Cao`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": metaDescription,
  "url": canonicalUrl,
  "datePublished": date,
  "dateModified": date,
  "image": ogImage,
  "author": {
    "@type": "Person",
    "name": "Eric Cao",
    "url": siteUrl,
    "sameAs": [
      "https://github.com/caoergou",
      "https://jike.city/ergou"
    ]
  },
  "publisher": {
    "@type": "Person",
    "name": "Eric Cao",
    "url": siteUrl
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "inLanguage": htmlLang
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": lang === 'zh' ? '首页' : 'Home',
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": lang === 'zh' ? '博客' : 'Blog',
      "item": `${siteUrl}/blog/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalUrl
    }
  ]
};
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Eric Cao</title>
  <meta name="description" content={metaDescription}>
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8">

  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang={htmlLang} href={canonicalUrl}>
  {hasAlternate && alternateUrl && (
    <link rel="alternate" hreflang={alternateHtmlLang} href={alternateUrl}>
  )}
  <link rel="alternate" hreflang="x-default" href={slug ? `${siteUrl}/blog/zh/${slug}/` : `${siteUrl}/blog/`}>
  <link rel="alternate" type="application/rss+xml" title="Eric Cao Blog RSS" href="/rss.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <meta property="og:type" content="article">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={`${title} - Eric Cao`}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content={ogLocale}>
  <meta property="article:published_time" content={date}>
  <meta property="article:author" content="Eric Cao">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} - Eric Cao`}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={ogImage}>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    :root {
      --navy: #0a192f;
      --light-navy: #112240;
      --lightest-navy: #233554;
      --dark-slate: #495670;
      --slate: #8892b0;
      --light-slate: #a8b2d1;
      --lightest-slate: #ccd6f6;
      --green: #64ffda;
      --green-tint: rgba(100, 255, 218, 0.1);

      --bg: var(--navy);
      --border: rgba(100, 255, 218, 0.1);
      --text-primary: var(--lightest-slate);
      --text-secondary: var(--slate);
      --text-muted: var(--dark-slate);
      --text-body: var(--light-slate);
      --accent: var(--green);

      --font-display: 'Fraunces', Georgia, 'Songti SC', 'STSong', 'Noto Serif SC', SimSun, serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
      --font-mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--navy);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(70% 50% at 15% 0%, rgba(100, 255, 218, 0.05), transparent 60%),
        radial-gradient(60% 50% at 100% 100%, rgba(87, 203, 255, 0.04), transparent 60%);
    }

    /* ── Slowly-drifting ambient aurora behind everything ── */
    body::after {
      content: '';
      position: fixed;
      inset: -25%;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(38% 38% at 22% 28%, rgba(100, 255, 218, 0.06), transparent 62%),
        radial-gradient(42% 42% at 78% 72%, rgba(87, 203, 255, 0.055), transparent 62%);
      filter: blur(40px);
      animation: aurora-drift 28s ease-in-out infinite alternate;
      will-change: transform;
    }

    @keyframes aurora-drift {
      0%   { transform: translate3d(-2%, -1%, 0) scale(1); }
      50%  { transform: translate3d(3%, 2%, 0)  scale(1.08); }
      100% { transform: translate3d(-1%, 3%, 0) scale(1.04); }
    }

    /* ── Cursor spotlight (Brittany Chiang style) ── */
    .spotlight {
      position: fixed;
      inset: 0;
      z-index: 30;
      pointer-events: none;
      --spot-x: 50%;
      --spot-y: 0%;
      background: radial-gradient(
        600px circle at var(--spot-x) var(--spot-y),
        rgba(100, 255, 218, 0.06),
        transparent 70%
      );
      will-change: background;
    }

    @media (hover: none), (prefers-reduced-motion: reduce) {
      .spotlight { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      body::after { animation: none; }
    }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Nav ── */
    .nav {
      padding: 2rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .nav-back:hover { color: var(--accent); }

    .nav-sep { color: var(--text-muted); font-size: 0.875rem; }

    .nav-current {
      font-size: 0.875rem;
      color: var(--text-secondary);
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ── Language toggle ── */
    .lang-toggle {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 100;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: rgba(10, 25, 47, 0.85);
      backdrop-filter: blur(8px);
      color: var(--accent);
      font-size: 0.75rem;
      font-family: var(--font-mono);
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .lang-toggle:hover {
      background: var(--green-tint);
      border-color: var(--accent);
    }

    /* ── Post header ── */
    .post-header {
      padding: 3rem 0 2.5rem;
      border-bottom: 1px solid var(--border);
    }

    .post-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.2;
      color: var(--lightest-slate);
      margin-bottom: 1.25rem;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .post-meta time {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }

    /* ── Article content ── */
    .post-content {
      padding: 2.5rem 0;
      font-size: 0.975rem;
      color: var(--text-body);
      line-height: 1.8;
    }

    .post-content h2,
    .post-content h3,
    .post-content h4 {
      font-family: var(--font-display);
      color: var(--lightest-slate);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.3;
      margin: 2.75rem 0 1rem;
    }

    .post-content h2 { font-size: 1.5rem; }
    .post-content h3 { font-size: 1.2rem; }
    .post-content h4 { font-size: 1rem; }

    .post-content p { margin: 1.25rem 0; }

    .post-content strong { color: var(--lightest-slate); font-weight: 600; }

    .post-content a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid rgba(99, 179, 237, 0.3);
      transition: border-color 0.2s ease;
    }

    .post-content a:hover {
      border-bottom-color: var(--accent);
    }

    .post-content code {
      font-family: var(--font-mono);
      font-size: 0.85em;
      background: var(--green-tint);
      color: var(--green);
      padding: 0.15em 0.4em;
      border-radius: 4px;
    }

    .post-content pre {
      background: rgba(2, 12, 27, 0.5);
      border: 1px solid var(--lightest-navy);
      border-radius: 8px;
      padding: 1.5rem;
      overflow-x: auto;
      margin: 1.75rem 0;
      line-height: 1.6;
    }

    .post-content pre code {
      font-family: var(--font-mono);
      background: transparent;
      color: var(--light-slate);
      padding: 0;
      font-size: 0.85rem;
    }

    .post-content blockquote {
      border-left: 2px solid var(--green);
      padding: 0.25rem 0 0.25rem 1.25rem;
      margin: 1.75rem 0;
      color: var(--light-slate);
    }

    .post-content ul,
    .post-content ol {
      margin: 1.25rem 0;
      padding-left: 1.5rem;
    }

    .post-content li { margin: 0.5rem 0; }
    .post-content li::marker { color: var(--green); }

    .post-content img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 1.75rem 0;
      border: 1px solid var(--border);
    }

    .post-content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    /* ── Footer ── */
    .footer {
      padding: 3rem 0;
      border-top: 1px solid var(--border);
    }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .post-content .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 1.75rem 0;
    }

    .post-content table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin: 0;
    }

    .post-content th,
    .post-content td {
      padding: 0.75rem 1rem;
      text-align: left;
      border: 1px solid var(--lightest-navy);
    }

    .post-content th {
      background: var(--lightest-navy);
      color: var(--lightest-slate);
      font-weight: 600;
      border-color: var(--dark-slate);
      white-space: nowrap;
    }

    .post-content tr:nth-child(even) td { background: rgba(35, 53, 84, 0.35); }
    .post-content tr:hover td { background: rgba(100, 255, 218, 0.05); }

    .post-content iframe {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 8px;
      margin: 1.75rem 0;
      display: block;
    }

    /* ── Strikethrough, mark, sup/sub ── */
    .post-content del, .post-content s {
      color: var(--dark-slate);
      text-decoration: line-through;
    }

    .post-content mark {
      background: rgba(100, 255, 218, 0.2);
      color: var(--lightest-slate);
      padding: 0.1em 0.25em;
      border-radius: 3px;
    }

    .post-content sup, .post-content sub {
      font-size: 0.75em;
      line-height: 0;
    }

    /* ── Post footer ── */
    .post-footer {
      margin: 3rem 0 0;
      padding: 2rem 0;
      border-top: 1px solid var(--border);
    }

    .post-footer-author {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .post-footer-avatar {
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--green-tint);
      border: 1px solid var(--border);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 1rem;
      color: var(--accent);
    }

    .post-footer-bio {
      flex: 1;
    }

    .post-footer-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--lightest-slate);
      margin-bottom: 0.35rem;
    }

    .post-footer-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 0.75rem;
    }

    .post-footer-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .post-footer-link {
      font-size: 0.8rem;
      font-family: var(--font-mono);
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s;
    }

    .post-footer-link:hover { border-bottom-color: var(--accent); }

    .post-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      font-size: 0.85rem;
    }

    .post-footer-nav a {
      color: var(--text-secondary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.2s;
    }

    .post-footer-nav a:hover { color: var(--accent); }

    @media (max-width: 640px) {
      .container { padding: 0 1.25rem; }
      .post-header { padding: 2rem 0 2rem; }
      .lang-toggle { top: 1rem; right: 1rem; }
    }
  </style>
</head>
<body>
  <div id="spotlight" class="spotlight" aria-hidden="true"></div>
  <div class="page">
    <div class="container">
      {hasAlternate && alternateUrl && (
        <a href={alternateUrl} class="lang-toggle" aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}>
          {lang === 'zh' ? 'EN' : '中'}
        </a>
      )}

      <nav class="nav">
        <a href="/blog" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          {lang === 'zh' ? '博客' : 'Blog'}
        </a>
        <span class="nav-sep">/</span>
        <span class="nav-current">{title}</span>
      </nav>

      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          {description && <span>· {description}</span>}
        </div>
      </header>

      <article class="post-content">
        <slot />
      </article>

      <div class="post-footer">
        <div class="post-footer-author">
          <div class="post-footer-avatar">EC</div>
          <div class="post-footer-bio">
            <div class="post-footer-name">Eric Cao</div>
            <div class="post-footer-desc">
              {lang === 'zh'
                ? '从大数据工程师到 LLM 应用开发，现专注研究 AI 工程化落地的真实瓶颈。参与贡献 Dify、lakeFS 等开源项目。'
                : 'From big data engineering to LLM apps, now focused on where enterprise AI adoption actually breaks down. Open-source contributor to Dify, lakeFS, and others.'}
            </div>
            <div class="post-footer-links">
              <a href="https://github.com/caoergou" class="post-footer-link" target="_blank" rel="noopener">GitHub</a>
              <a href="https://jike.city/ergou" class="post-footer-link" target="_blank" rel="noopener">即刻</a>
              <a href="/blog" class="post-footer-link">{lang === 'zh' ? '← 更多文章' : '← More articles'}</a>
            </div>
          </div>
        </div>

        <div class="post-footer-nav">
          <a href="/blog">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            {lang === 'zh' ? '返回博客列表' : 'Back to blog'}
          </a>
          <span style="color:var(--text-muted);font-size:0.75rem;font-family:var(--font-mono)">© 2026 Eric Cao</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Cursor spotlight — smooth lerp follow (matches the home page)
    (function () {
      const spot = document.getElementById('spotlight');
      if (!spot) return;
      const noHover = window.matchMedia('(hover: none)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (noHover || reduced) return;

      let targetX = window.innerWidth / 2, targetY = 0;
      let curX = targetX, curY = targetY, raf = null;

      function tick() {
        curX += (targetX - curX) * 0.14;
        curY += (targetY - curY) * 0.14;
        spot.style.setProperty('--spot-x', curX + 'px');
        spot.style.setProperty('--spot-y', curY + 'px');
        if (Math.abs(targetX - curX) > 0.5 || Math.abs(targetY - curY) > 0.5) {
          raf = requestAnimationFrame(tick);
        } else {
          raf = null;
        }
      }

      window.addEventListener('mousemove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
        if (raf === null) raf = requestAnimationFrame(tick);
      }, { passive: true });
    })();
  </script>
</body>
</html>
