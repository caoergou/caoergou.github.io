---
interface Props {
  title: string;
  date: string;
  description?: string;
  slug?: string;
}

const { title, date, description, slug } = Astro.props;
const siteUrl = 'https://eric.run.place';
const canonicalUrl = slug ? `${siteUrl}/blog/${slug}/` : `${siteUrl}/blog/`;
const ogImage = `${siteUrl}/og-image.png`;
const metaDescription = description || `${title} - Eric Cao 的技术文章`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": metaDescription,
  "url": canonicalUrl,
  "datePublished": date,
  "dateModified": date,
  "image": ogImage,
  "author": {
    "@type": "Person",
    "name": "Eric Cao",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "Eric Cao",
    "url": siteUrl
  }
};
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Eric Cao</title>
  <meta name="description" content={metaDescription}>
  <meta name="author" content="Eric Cao">

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl}>

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={`${title} - Eric Cao`}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">
  <meta property="article:published_time" content={date}>
  <meta property="article:author" content="Eric Cao">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} - Eric Cao`}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={ogImage}>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    :root {
      --bg: #080c14;
      --surface: rgba(255, 255, 255, 0.04);
      --border: rgba(255, 255, 255, 0.08);
      --text-primary: rgba(255, 255, 255, 0.92);
      --text-secondary: rgba(255, 255, 255, 0.5);
      --text-muted: rgba(255, 255, 255, 0.3);
      --text-body: rgba(255, 255, 255, 0.75);
      --accent: #63b3ed;
      --accent-dim: rgba(99, 179, 237, 0.12);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', 'Noto Sans SC', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Nav ── */
    .nav {
      padding: 2rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .nav-back:hover { color: var(--accent); }

    .nav-sep { color: var(--text-muted); font-size: 0.875rem; }

    .nav-current {
      font-size: 0.875rem;
      color: var(--text-secondary);
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ── Post header ── */
    .post-header {
      padding: 3rem 0 2.5rem;
      border-bottom: 1px solid var(--border);
    }

    .post-title {
      font-size: clamp(1.6rem, 5vw, 2.2rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--text-primary);
      margin-bottom: 1rem;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .post-meta time {
      font-variant-numeric: tabular-nums;
    }

    /* ── Article content ── */
    .post-content {
      padding: 2.5rem 0;
      font-size: 0.975rem;
      color: var(--text-body);
      line-height: 1.8;
    }

    .post-content h2,
    .post-content h3,
    .post-content h4 {
      color: var(--text-primary);
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: 2.5rem 0 1rem;
    }

    .post-content h2 { font-size: 1.35rem; }
    .post-content h3 { font-size: 1.1rem; }
    .post-content h4 { font-size: 0.975rem; }

    .post-content p { margin: 1.25rem 0; }

    .post-content a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid rgba(99, 179, 237, 0.3);
      transition: border-color 0.2s ease;
    }

    .post-content a:hover {
      border-bottom-color: var(--accent);
    }

    .post-content code {
      font-family: 'Consolas', 'Monaco', 'Fira Code', monospace;
      font-size: 0.875em;
      background: rgba(99, 179, 237, 0.1);
      color: var(--accent);
      padding: 0.15em 0.4em;
      border-radius: 4px;
    }

    .post-content pre {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      overflow-x: auto;
      margin: 1.75rem 0;
    }

    .post-content pre code {
      background: transparent;
      color: var(--text-body);
      padding: 0;
      font-size: 0.875rem;
    }

    .post-content blockquote {
      border-left: 2px solid var(--accent);
      padding-left: 1.25rem;
      margin: 1.75rem 0;
      color: var(--text-secondary);
      font-style: italic;
    }

    .post-content ul,
    .post-content ol {
      margin: 1.25rem 0;
      padding-left: 1.5rem;
    }

    .post-content li { margin: 0.4rem 0; }

    .post-content img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 1.75rem 0;
      border: 1px solid var(--border);
    }

    .post-content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    /* ── Footer ── */
    .footer {
      padding: 3rem 0;
      border-top: 1px solid var(--border);
    }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    @media (max-width: 640px) {
      .container { padding: 0 1.25rem; }
      .post-header { padding: 2rem 0 2rem; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <nav class="nav">
        <a href="/blog" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          博客
        </a>
        <span class="nav-sep">/</span>
        <span class="nav-current">{title}</span>
      </nav>

      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{date}</time>
          {description && <span>· {description}</span>}
        </div>
      </header>

      <article class="post-content">
        <slot />
      </article>

      <footer class="footer">
        <span class="footer-copy">© 2026 Eric Cao</span>
      </footer>
    </div>
  </div>
</body>
</html>
