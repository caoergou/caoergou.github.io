---
import type { CollectionEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import Project from '../components/Project.astro';
import Thought from '../components/Thought.astro';
import TechCloud from '../components/TechCloud.astro';

interface Props {
  profile: CollectionEntry<'profile'>;
  projects: CollectionEntry<'projects'>[];
  thoughts: CollectionEntry<'thoughts'>[];
}

const { profile, projects, thoughts } = Astro.props;
const siteUrl = 'https://eric.run.place';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eric Cao — 在AI席卷的浪潮中努力扑腾</title>
  <meta name="description" content="一个喜欢折腾的开发者，在AI席卷的浪潮中努力扑腾。">
  <meta name="keywords" content="Eric Cao, Python, AI Agent, Dify, Airflow, 大数据, 开源, TypeScript, React">
  <meta name="author" content="Eric Cao">

  <!-- Search Engine Verification -->
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8" />
  <meta name="baidu-site-verification" content="codeva-4Lwu94LneY" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content="Eric Cao — 在AI席卷的浪潮中努力扑腾">
  <meta property="og:description" content="一个喜欢折腾的开发者，在AI席卷的浪潮中努力扑腾。">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:url" content={siteUrl}>
  <meta name="twitter:title" content="Eric Cao — 在AI席卷的浪潮中努力扑腾">
  <meta name="twitter:description" content="一个喜欢折腾的开发者，在AI席卷的浪潮中努力扑腾。">

  <!-- Canonical URL -->
  <link rel="canonical" href={siteUrl}>

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Pixel fonts for game style -->
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* ===== Pixel Game Theme - Zelda Style ===== */
    :root {
      /* Dark Theme - Night Sky Adventure */
      --bg: #1a1a2e;
      --bg-secondary: #16213e;
      --surface: #2d3a4f;
      --surface-alt: #3d4a5f;
      --border: #5a6a7a;
      --border-light: #7a8a9a;
      --text-primary: #f0f0e8;
      --text-secondary: #a8b8c8;
      --text-muted: #6a7a8a;

      /* Nintendo-inspired colors */
      --accent: #ffd93d;       /* Gold - treasure/rewards */
      --accent-2: #6bcb77;     /* Green - nature/life */
      --accent-3: #4d96ff;     /* Blue - magic/water */
      --accent-4: #ff6b6b;     /* Red - danger/heart */
      --accent-5: #c9b1ff;     /* Purple - temple/mystery */

      /* Pixel-specific */
      --pixel-size: 4px;
      --pixel-border: 4px solid var(--border);

      /* Shadows */
      --shadow-pixel:
        4px 0 0 var(--border),
        -4px 0 0 var(--border),
        0 4px 0 var(--border),
        0 -4px 0 var(--border);
      --shadow-pixel-accent:
        4px 0 0 var(--accent),
        -4px 0 0 var(--accent),
        0 4px 0 var(--accent),
        0 -4px 0 var(--accent);

      /* Animation */
      --transition-fast: 0.15s step-end;
      --transition-normal: 0.3s step-end;
    }

    /* Light Theme - Daytime Adventure */
    .light-mode {
      --bg: #e8f4f8;
      --bg-secondary: #d4e8e0;
      --surface: #ffffff;
      --surface-alt: #f5f5f0;
      --border: #a0b0a0;
      --border-light: #c0d0c0;
      --text-primary: #2a3a4a;
      --text-secondary: #4a5a6a;
      --text-muted: #7a8a9a;

      --accent: #e6a800;
      --accent-2: #4a9e5a;
      --accent-3: #2a7ecc;
      --accent-4: #d64545;
      --accent-5: #9a7acc;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'VT323', monospace;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: none;
      -moz-osx-font-smoothing: none;
      image-rendering: pixelated;
    }

    /* Pixel fonts utility */
    .pixel-font { font-family: 'Press Start 2P', cursive; }
    .pixel-body { font-family: 'VT323', monospace; }
    .serif { font-family: 'Noto Serif SC', serif; }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ===== Pixel Star Background ===== */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      background-color: var(--bg);
      background-image:
        /* Stars layer 1 - small */
        radial-gradient(1px 1px at 10% 20%, var(--accent) 50%, transparent 50%),
        radial-gradient(1px 1px at 30% 50%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(1px 1px at 50% 10%, var(--accent-3) 50%, transparent 50%),
        radial-gradient(1px 1px at 70% 40%, var(--accent-5) 50%, transparent 50%),
        radial-gradient(1px 1px at 90% 60%, var(--accent) 50%, transparent 50%),
        /* Stars layer 2 - medium */
        radial-gradient(2px 2px at 15% 80%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(2px 2px at 45% 30%, var(--accent-3) 50%, transparent 50%),
        radial-gradient(2px 2px at 85% 70%, var(--accent-5) 50%, transparent 50%),
        /* Stars layer 3 - large */
        radial-gradient(3px 3px at 25% 65%, var(--accent) 50%, transparent 50%),
        radial-gradient(3px 3px at 65% 85%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(3px 3px at 95% 25%, var(--accent-3) 50%, transparent 50%);
      animation: twinkle 8s ease-in-out infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    /* CRT Scanline effect (subtle) */
    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1000;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.03) 2px,
        rgba(0, 0, 0, 0.03) 4px
      );
    }

    /* ===== Hero Section ===== */
    .hero {
      min-height: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem 0 2rem;
      position: relative;
    }

    .hero-name {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.5rem, 6vw, 2.5rem);
      letter-spacing: -0.02em;
      line-height: 1.4;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
      text-shadow:
        3px 3px 0 var(--accent),
        -1px -1px 0 var(--border);
      animation: pixelFadeIn 0.8s steps(8) forwards;
    }

    @keyframes pixelFadeIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-name:hover {
      animation: pixelShake 0.3s steps(4) forwards;
    }

    @keyframes pixelShake {
      0%, 100% { transform: translate(0); }
      25% { transform: translate(-2px, 2px); }
      50% { transform: translate(2px, -2px); }
      75% { transform: translate(-2px, -2px); }
    }

    .hero-tagline {
      font-family: 'VT323', monospace;
      font-size: clamp(1.1rem, 3vw, 1.4rem);
      color: var(--accent-2);
      padding-left: 1rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
      max-width: 100%;
      border-left: 4px solid var(--accent-2);
      background: linear-gradient(90deg, rgba(107, 203, 119, 0.1) 0%, transparent 100%);
    }

    .hero-links {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-primary);
      text-decoration: none;
      font-family: 'Press Start 2P', cursive;
      font-size: 0.6rem;
      letter-spacing: 0.02em;
      cursor: pointer;
      padding: 0.75rem 1rem;
      background: var(--surface);
      border: none;
      box-shadow: var(--shadow-pixel);
      transition: transform var(--transition-fast);
      position: relative;
    }

    .hero-link:hover {
      transform: translate(-2px, -2px);
      box-shadow:
        6px 0 0 var(--accent),
        -6px 0 0 var(--accent),
        0 6px 0 var(--accent),
        0 -6px 0 var(--accent),
        6px 6px 0 var(--accent);
    }

    .hero-link:active {
      transform: translate(2px, 2px);
      box-shadow:
        2px 0 0 var(--accent),
        -2px 0 0 var(--accent),
        0 2px 0 var(--accent),
        0 -2px 0 var(--accent);
    }

    /* ===== Hero Stats (Adventure Style) ===== */
    .hero-stats {
      display: flex;
      gap: 2rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 4px solid var(--border);
    }

    .stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-value {
      font-family: 'Press Start 2P', cursive;
      font-size: 1rem;
      color: var(--accent);
      text-shadow: 2px 2px 0 rgba(255, 217, 61, 0.3);
    }

    .stat-label {
      font-family: 'VT323', monospace;
      font-size: 0.9rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    /* ===== Sections ===== */
    .section {
      padding: 2.5rem 0;
      border-top: 4px solid var(--border);
      position: relative;
    }

    .section-title {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      padding-bottom: 0.5rem;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: var(--accent);
      animation: pixelExpand 1s steps(10) forwards;
    }

    @keyframes pixelExpand {
      from { width: 0; }
      to { width: 100%; }
    }

    /* ===== Project List ===== */
    .projects-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* ===== Thoughts List ===== */
    .thoughts-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* ===== Coming Soon Section ===== */
    .coming-soon {
      background:
        repeating-linear-gradient(
          45deg,
          var(--surface) 0px,
          var(--surface) 4px,
          var(--surface-alt) 4px,
          var(--surface-alt) 8px
        );
      padding: 1.5rem;
      box-shadow: var(--shadow-pixel);
    }

    .coming-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .coming-item {
      font-family: 'VT323', monospace;
      font-size: 1.1rem;
      color: var(--text-secondary);
      padding-left: 1.5rem;
      position: relative;
      line-height: 1.5;
    }

    .coming-item::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .coming-item:hover {
      color: var(--text-primary);
    }

    .coming-item:hover::before {
      color: var(--accent-2);
      animation: pixelBlink 0.5s steps(2) infinite;
    }

    @keyframes pixelBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* ===== Footer ===== */
    .footer {
      padding: 2rem 0;
      border-top: 4px solid var(--border);
      margin-top: 2rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-copy {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.5rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .footer-links {
      display: flex;
      gap: 1rem;
    }

    .footer-link {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.5rem;
      color: var(--text-secondary);
      text-decoration: none;
      cursor: pointer;
      padding: 0.5rem 0.75rem;
      background: var(--surface);
      box-shadow:
        2px 0 0 var(--border),
        -2px 0 0 var(--border),
        0 2px 0 var(--border),
        0 -2px 0 var(--border);
      transition: all var(--transition-fast);
    }

    .footer-link:hover {
      color: var(--accent);
      box-shadow:
        2px 0 0 var(--accent),
        -2px 0 0 var(--accent),
        0 2px 0 var(--accent),
        0 -2px 0 var(--accent);
    }

    /* ===== Tech Section ===== */
    .tech-section {
      padding: 1.5rem 0;
      border-top: none;
    }

    /* ===== Responsive Design ===== */
    @media (max-width: 768px) {
      .container { padding: 0 1rem; }

      .hero { padding: 2rem 0 1.5rem; }
      .hero-name { font-size: 1.25rem; }
      .hero-tagline { font-size: 1rem; }
      .hero-link { font-size: 0.5rem; padding: 0.6rem 0.8rem; }

      .hero-stats {
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      .section { padding: 2rem 0; }
      .section-title { font-size: 0.55rem; }

      .footer-content {
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-copy { font-size: 0.45rem; }
      .footer-link { font-size: 0.45rem; }
    }

    @media (max-width: 480px) {
      .hero-links {
        flex-direction: column;
        gap: 0.5rem;
      }

      .hero-link {
        width: 100%;
        justify-content: center;
      }

      .stat-value { font-size: 0.8rem; }
      .stat-label { font-size: 0.8rem; }
    }

    /* ===== Safari Compatibility ===== */
    @supports (-webkit-hyphens: none) {
      /* Safari-specific fixes */
      .hero-name {
        -webkit-text-stroke: 0;
      }

      body::after {
        -webkit-backdrop-filter: none;
      }

      /* Fix for Safari position: fixed issues */
      .page {
        -webkit-overflow-scrolling: touch;
      }
    }

    /* ===== Reduced Motion ===== */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ===== Selection Styling ===== */
    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    /* ===== Scrollbar Styling ===== */
    ::-webkit-scrollbar {
      width: 12px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border: 2px solid var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--accent);
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <Hero profile={profile} />

      <section class="section tech-section">
        <TechCloud />
      </section>

      <section class="section">
        <h2 class="section-title" data-text-zh="作品" data-text-en="Projects">作品</h2>
        <div class="projects-list">
          {projects.map((project) => (
            <Project key={project.id} project={project} />
          ))}
        </div>
      </section>

      <section class="section">
        <h2 class="section-title" data-text-zh="探索方向" data-text-en="Explorations">探索方向</h2>
        <div class="thoughts-list">
          {thoughts.map((thought) => (
            <Thought key={thought.id} thought={thought} />
          ))}
        </div>
      </section>

      <section class="section coming-soon">
        <h2 class="section-title">Coming Soon</h2>
        <div class="coming-list">
          <div class="coming-item" data-text-zh="个人/团队专属 AI Agent 工作流的从零搭建全流程" data-text-en="Complete guide to building personal/team AI Agent workflows from scratch">个人/团队专属 AI Agent 工作流的从零搭建全流程</div>
          <div class="coming-item" data-text-zh="企业级场景下 Agent 自动化流程的落地实战记录" data-text-en="Enterprise Agent automation implementation case studies">企业级场景下 Agent 自动化流程的落地实战记录</div>
          <div class="coming-item" data-text-zh="大数据与 AI Agent 结合的场景化解决方案" data-text-en="Big Data + AI Agent scenario-based solutions">大数据与 AI Agent 结合的场景化解决方案</div>
          <div class="coming-item" data-text-zh="全链路性能优化的系列避坑指南与实战技巧" data-text-en="End-to-end performance optimization pitfalls and practical tips">全链路性能优化的系列避坑指南与实战技巧</div>
        </div>
      </section>


      <footer class="footer">
        <div class="footer-content">
          <span class="footer-copy">© {new Date().getFullYear()} Eric Cao</span>
          <div class="footer-links">
            <a href="https://github.com/caoergou" class="footer-link" target="_blank" rel="noopener">GitHub</a>
            <a href="https://jike.city/ergou" class="footer-link" target="_blank" rel="noopener">即刻</a>
            <a href="mailto:itsericsmail@gmail.com" class="footer-link">Email</a>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script is:inline>
    // Global language switching - direct text replacement (no typewriter for stability)
    let currentLang = localStorage.getItem('lang') || 'zh';

    function updateAllText(lang) {
      currentLang = lang;
      localStorage.setItem('lang', lang);

      // Update section titles
      document.querySelectorAll('[data-text-zh]').forEach(el => {
        const text = el.getAttribute(`data-text-${lang}`);
        if (text) el.textContent = text;
      });

      // Update project descriptions
      document.querySelectorAll('[data-desc-zh]').forEach(el => {
        const text = el.getAttribute(`data-desc-${lang}`);
        if (text) el.textContent = text;
      });

      // Update project demo links
      document.querySelectorAll('[data-link-zh]').forEach(el => {
        const text = el.getAttribute(`data-link-${lang}`);
        if (text) el.textContent = text;
      });

      // Update thought titles
      document.querySelectorAll('[data-title-zh]').forEach(el => {
        const text = el.getAttribute(`data-title-${lang}`);
        if (text) el.textContent = text;
      });

      // Update buttons
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === lang);
      });

      // Dispatch custom event for Hero component
      window.dispatchEvent(new CustomEvent('langChange', { detail: { lang } }));
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
      updateAllText(currentLang);

      // Language switch listeners
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => updateAllText(btn.dataset.lang));
      });
    });
  </script>
</body>
</html>
