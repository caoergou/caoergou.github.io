---
import type { CollectionEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import Project from '../components/Project.astro';
import Thought from '../components/Thought.astro';
import TechCloud from '../components/TechCloud.astro';
import GameEggs from '../components/GameEggs.astro';
import { t, getClientTranslations, getI18nClientScript, getTranslations, type Lang } from '../i18n';

interface Props {
  profile: CollectionEntry<'profile'>;
  projects: CollectionEntry<'projects'>[];
  thoughts: CollectionEntry<'thoughts'>[];
}

const { profile, projects, thoughts } = Astro.props;
const siteUrl = 'https://eric.run.place';

// i18n helper for server-side rendering
const getTranslation = (lang: Lang, key: string) => t(lang, key);

// Get translations for client-side injection
const clientTranslations = getClientTranslations();
const i18nClientScript = getI18nClientScript();

// SSR default content (Chinese) for coming-soon section
const zhComingSoonItems = getTranslations('zh').comingSoon.items;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n="site.title">{getTranslation('zh', 'site.title')}</title>
  <meta name="description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="keywords" content="Eric Cao, Python, AI Agent, Dify, Airflow, 大数据, 开源, TypeScript, React, Full-Stack, Developer">
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">

  <!-- Search Engine Verification -->
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8" />
  <meta name="baidu-site-verification" content="codeva-4Lwu94LneY" />

  <!-- i18n: Language and Alternate Links -->
  <link rel="alternate" hreflang="zh-CN" href={siteUrl} />
  <link rel="alternate" hreflang="en-US" href={siteUrl} />
  <link rel="alternate" hreflang="x-default" href={siteUrl} />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta property="og:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN" data-og-locale="zh_CN">
  <meta property="og:locale:alternate" content="en_US">
  <meta property="og:image" content={`${siteUrl}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Eric Cao 的个人网站 - Python 开发者与开源贡献者，专注于 AI Agent、大数据、Web 开发">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@caoergou">
  <meta name="twitter:url" content={siteUrl}>
  <meta name="twitter:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta name="twitter:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`}>

  <!-- Canonical URL -->
  <link rel="canonical" href={siteUrl}>

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Eric Cao",
    "alternateName": "caoergou",
    "url": siteUrl,
    "image": `${siteUrl}/avatar.png`,
    "sameAs": [
      "https://github.com/caoergou",
      "https://jike.city/ergou"
    ],
    "jobTitle": "Full-Stack Developer",
    "description": getTranslation('zh', 'site.description'),
    "knowsAbout": ["Python", "TypeScript", "AI Agent", "Dify", "Airflow", "Big Data", "React"],
    "inLanguage": {
      "@type": "Language",
      "name": "Chinese",
      "alternateName": "zh-CN"
    }
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Pixel fonts for game style -->
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* ===== Pixel Game Theme - Zelda Style ===== */
    :root {
      /* Dark Theme - Night Sky Adventure */
      --bg: #1a1a2e;
      --bg-secondary: #16213e;
      --surface: #2d3a4f;
      --surface-alt: #3d4a5f;
      --border: #5a6a7a;
      --border-light: #7a8a9a;
      --text-primary: #f0f0e8;
      --text-secondary: #a8b8c8;
      --text-muted: #6a7a8a;

      /* Nintendo-inspired colors */
      --accent: #ffd93d;       /* Gold - treasure/rewards */
      --accent-2: #6bcb77;     /* Green - nature/life */
      --accent-3: #4d96ff;     /* Blue - magic/water */
      --accent-4: #ff6b6b;     /* Red - danger/heart */
      --accent-5: #c9b1ff;     /* Purple - temple/mystery */

      /* Pixel-specific */
      --pixel-size: 4px;
      --pixel-border: 4px solid var(--border);

      /* Shadows */
      --shadow-pixel:
        4px 0 0 var(--border),
        -4px 0 0 var(--border),
        0 4px 0 var(--border),
        0 -4px 0 var(--border);
      --shadow-pixel-accent:
        4px 0 0 var(--accent),
        -4px 0 0 var(--accent),
        0 4px 0 var(--accent),
        0 -4px 0 var(--accent);

      /* Animation */
      --transition-fast: 0.15s step-end;
      --transition-normal: 0.3s step-end;
    }

    /* Light Theme - Daytime Adventure */
    .light-mode {
      --bg: #e8f4f8;
      --bg-secondary: #d4e8e0;
      --surface: #ffffff;
      --surface-alt: #f5f5f0;
      --border: #a0b0a0;
      --border-light: #c0d0c0;
      --text-primary: #2a3a4a;
      --text-secondary: #4a5a6a;
      --text-muted: #7a8a9a;

      --accent: #e6a800;
      --accent-2: #4a9e5a;
      --accent-3: #2a7ecc;
      --accent-4: #d64545;
      --accent-5: #9a7acc;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'VT323', monospace;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: none;
      -moz-osx-font-smoothing: none;
      image-rendering: pixelated;
    }

    /* Pixel fonts utility */
    .pixel-font { font-family: 'Press Start 2P', cursive; }
    .pixel-body { font-family: 'VT323', monospace; }
    .serif { font-family: 'Noto Serif SC', serif; }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ===== Pixel Star Background ===== */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      background-color: var(--bg);
      background-image:
        /* Stars layer 1 - small */
        radial-gradient(1px 1px at 10% 20%, var(--accent) 50%, transparent 50%),
        radial-gradient(1px 1px at 30% 50%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(1px 1px at 50% 10%, var(--accent-3) 50%, transparent 50%),
        radial-gradient(1px 1px at 70% 40%, var(--accent-5) 50%, transparent 50%),
        radial-gradient(1px 1px at 90% 60%, var(--accent) 50%, transparent 50%),
        /* Stars layer 2 - medium */
        radial-gradient(2px 2px at 15% 80%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(2px 2px at 45% 30%, var(--accent-3) 50%, transparent 50%),
        radial-gradient(2px 2px at 85% 70%, var(--accent-5) 50%, transparent 50%),
        /* Stars layer 3 - large */
        radial-gradient(3px 3px at 25% 65%, var(--accent) 50%, transparent 50%),
        radial-gradient(3px 3px at 65% 85%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(3px 3px at 95% 25%, var(--accent-3) 50%, transparent 50%);
      animation: twinkle 8s ease-in-out infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    /* CRT Scanline effect (subtle) */
    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1000;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.03) 2px,
        rgba(0, 0, 0, 0.03) 4px
      );
    }

    /* ===== Sections ===== */
    .section {
      padding: 3rem 0 2.5rem;
      position: relative;
    }

    /* MC 风格多彩像素分割线 */
    .section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(
        to right,
        var(--accent-2) 0 25%,
        var(--accent) 25% 50%,
        var(--accent-3) 50% 75%,
        var(--accent-5) 75% 100%
      );
    }

    .section-title {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      padding-bottom: 0.5rem;
      padding-left: 1.2em;
    }

    /* 塞尔达风格菜单光标 */
    .section-title::before {
      content: '►';
      position: absolute;
      left: 0;
      color: var(--accent-2);
      animation: pixelBlink 1.2s steps(2) infinite;
    }

    /* 多彩像素下划线 */
    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(
        to right,
        var(--accent-2) 0 25%,
        var(--accent) 25% 50%,
        var(--accent-3) 50% 75%,
        var(--accent-5) 75% 100%
      );
      animation: pixelExpand 1s steps(10) forwards;
    }

    @keyframes pixelExpand {
      from { width: 0; }
      to { width: 100%; }
    }

    /* ===== Project List ===== */
    .projects-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* ===== Thoughts List ===== */
    .thoughts-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* ===== Coming Soon Section ===== */
    /* 地下城石块网格纹理 */
    .coming-soon {
      background: var(--surface);
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent 0px,
          transparent 15px,
          rgba(0, 0, 0, 0.06) 15px,
          rgba(0, 0, 0, 0.06) 16px
        ),
        repeating-linear-gradient(
          90deg,
          transparent 0px,
          transparent 15px,
          rgba(0, 0, 0, 0.04) 15px,
          rgba(0, 0, 0, 0.04) 16px
        );
      padding: 1.5rem;
      box-shadow: var(--shadow-pixel);
      border-left: 4px solid var(--accent-5);
    }

    .coming-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .coming-item {
      font-family: 'VT323', monospace;
      font-size: 1.1rem;
      color: var(--text-secondary);
      padding-left: 1.5rem;
      position: relative;
      line-height: 1.5;
    }

    .coming-item::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .coming-item:hover {
      color: var(--text-primary);
    }

    .coming-item:hover::before {
      color: var(--accent-2);
      animation: pixelBlink 0.5s steps(2) infinite;
    }

    @keyframes pixelBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* ===== Footer ===== */
    .footer {
      padding: 2rem 0;
      border-top: 4px solid var(--border);
      margin-top: 2rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-copy {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.5rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .footer-links {
      display: flex;
      gap: 1rem;
    }

    .footer-link {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.5rem;
      color: var(--text-secondary);
      text-decoration: none;
      cursor: pointer;
      padding: 0.5rem 0.75rem;
      background: var(--surface);
      box-shadow:
        2px 0 0 var(--border),
        -2px 0 0 var(--border),
        0 2px 0 var(--border),
        0 -2px 0 var(--border);
      transition: all var(--transition-fast);
    }

    .footer-link:hover {
      color: var(--accent);
      box-shadow:
        2px 0 0 var(--accent),
        -2px 0 0 var(--accent),
        0 2px 0 var(--accent),
        0 -2px 0 var(--accent);
    }

    /* 隐藏的 Konami Code 提示 */
    .footer-secret {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.35rem;
      color: var(--text-muted);
      margin-top: 1rem;
      text-align: center;
      opacity: 0.3;
      letter-spacing: 0.1em;
      transition: opacity 0.3s step-end;
      cursor: default;
    }

    .footer-secret:hover {
      opacity: 0.7;
      color: var(--accent-5);
    }

    /* ===== Tech Section ===== */
    .tech-section {
      padding: 1.5rem 0;
    }

    .tech-section::before {
      display: none;
    }

    /* ===== Responsive Design ===== */
    @media (max-width: 768px) {
      .container { padding: 0 1rem; }

      .section { padding: 2.5rem 0 2rem; }
      .section-title { font-size: 0.6rem; }

      .footer-content {
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-copy { font-size: 0.45rem; }
      .footer-link { font-size: 0.45rem; }
    }

    /* ===== Safari Compatibility ===== */
    @supports (-webkit-hyphens: none) {
      body::after {
        -webkit-backdrop-filter: none;
      }

      /* Fix for Safari position: fixed issues */
      .page {
        -webkit-overflow-scrolling: touch;
      }
    }

    /* ===== Reduced Motion ===== */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ===== Selection Styling ===== */
    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    /* ===== Scrollbar Styling ===== */
    ::-webkit-scrollbar {
      width: 12px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border: 2px solid var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--accent);
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <Hero profile={profile} />

      <section id="skills" class="section tech-section" data-achievement="skills">
        <TechCloud />
      </section>

      <section id="projects" class="section" data-achievement="projects">
        <h2 class="section-title" data-i18n="sections.projects">{getTranslation('zh', 'sections.projects')}</h2>
        <div class="projects-list">
          {projects.map((project) => (
            <Project key={project.id} project={project} />
          ))}
        </div>
      </section>

      <section id="thoughts" class="section" data-achievement="thoughts">
        <h2 class="section-title" data-i18n="sections.explorations">{getTranslation('zh', 'sections.explorations')}</h2>
        <div class="thoughts-list">
          {thoughts.map((thought) => (
            <Thought key={thought.id} thought={thought} />
          ))}
        </div>
      </section>

      <section id="coming" class="section coming-soon" data-achievement="coming">
        <h2 class="section-title" data-i18n="comingSoon.title">{getTranslation('zh', 'comingSoon.title')}</h2>
        <div class="coming-list" id="coming-list">
          {zhComingSoonItems.map((item) => (
            <div class="coming-item">{item}</div>
          ))}
        </div>
      </section>


      <footer class="footer">
        <div class="footer-content">
          <span class="footer-copy">© {new Date().getFullYear()} Eric Cao</span>
          <div class="footer-links">
            <a href="https://github.com/caoergou" class="footer-link" target="_blank" rel="noopener">GitHub</a>
            <a href="https://jike.city/ergou" class="footer-link" target="_blank" rel="noopener">即刻</a>
            <a href="mailto:itsericsmail@gmail.com" class="footer-link">Email</a>
          </div>
        </div>
        <div class="footer-secret" aria-hidden="true" title="↑↑↓↓←→←→BA">🎮 There are secrets here...</div>
      </footer>
    </div>
  </div>

  <!-- 游戏彩蛋系统 -->
  <GameEggs />

  <!-- i18n runtime: translations injected as data-translations attribute -->
  <script is:inline data-translations={clientTranslations} set:html={i18nClientScript} />
</body>
</html>
