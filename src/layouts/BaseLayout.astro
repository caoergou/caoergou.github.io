---
import type { CollectionEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import Project from '../components/Project.astro';
import Thought from '../components/Thought.astro';

interface Props {
  profile: CollectionEntry<'profile'>;
  projects: CollectionEntry<'projects'>[];
}

const { profile, projects } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eric Cao — 构建工具，也质疑工具</title>
  <meta name="description" content="Python 工程师，开源创作者。构建工具，也质疑工具存在的理由。">
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8" />
  <meta name="baidu-site-verification" content="codeva-4Lwu94LneY" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* Dark Theme (default) */
    :root {
      --bg: #0d0d0d;
      --bg-secondary: #1a1a1a;
      --surface: #141414;
      --border: #2a2a2a;
      --text-primary: #ffffff;
      --text-secondary: #a0a0a0;
      --text-muted: #666666;
      --accent: #00ff88;
      --accent-2: #ff0066;
      --accent-3: #00d4ff;
      --accent-glow: rgba(0, 255, 136, 0.3);
      --grid-color: rgba(255, 255, 255, 0.03);
    }

    /* Light Theme */
    .light-mode {
      --bg: #f8f9fa;
      --bg-secondary: #e9ecef;
      --surface: #ffffff;
      --border: #dee2e6;
      --text-primary: #1a1a1a;
      --text-secondary: #495057;
      --text-muted: #868e96;
      --accent: #007bff;
      --accent-2: #dc3545;
      --accent-3: #17a2b8;
      --accent-glow: rgba(0, 123, 255, 0.2);
      --grid-color: rgba(0, 0, 0, 0.03);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.7;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .serif { font-family: 'Noto Serif SC', serif; }
    .grotesk { font-family: 'Space Grotesk', sans-serif; }

    .page { position: relative; z-index: 1; min-height: 100vh; }
    .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

    /* Cyber grid background */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image:
        linear-gradient(var(--grid-color) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 0;
    }

    /* Scanline effect */
    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        transparent 50%,
        var(--accent-glow) 50%
      );
      background-size: 100% 4px;
      pointer-events: none;
      z-index: 0;
      opacity: 0.3;
    }

    /* Hero */
    .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 6rem 0 4rem; }

    .hero-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2.5rem, 9vw, 4.5rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 0.9;
      margin-bottom: 2rem;
      color: var(--text-primary);
      text-transform: uppercase;
      position: relative;
      display: inline-block;
      background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 30px var(--accent-glow));
    }

    .hero-tagline {
      font-size: clamp(1rem, 3vw, 1.2rem);
      color: var(--text-secondary);
      font-weight: 300;
      line-height: 1.7;
      max-width: 560px;
      margin-bottom: 3rem;
      font-family: 'Inter', sans-serif;
      opacity: 0;
    }

    .hero-quote {
      font-size: clamp(0.95rem, 2.5vw, 1.05rem);
      color: var(--accent);
      font-style: normal;
      border-left: 3px solid var(--accent);
      padding-left: 1.5rem;
      margin-bottom: 3rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      opacity: 0;
    }

    .hero-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-primary);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.2s ease;
      cursor: pointer;
      padding: 0.75rem 1.5rem;
      border: 1px solid var(--border);
      background: var(--surface);
      position: relative;
      overflow: hidden;
    }
    .hero-link::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, var(--accent-glow), transparent);
      transition: left 0.5s ease;
    }
    .hero-link:hover::before {
      left: 100%;
    }
    .hero-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      box-shadow: 0 0 20px var(--accent-glow);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Section */
    .section { padding: 6rem 0; border-top: 1px solid var(--border); }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 3rem;
      position: relative;
      display: inline-block;
      text-shadow: 0 0 20px var(--accent-glow);
    }

    /* Projects */
    .projects-list { display: flex; flex-direction: column; gap: 0; }

    /* Thoughts */
    .thoughts-list { display: flex; flex-direction: column; gap: 0; }

    /* Footer */
    .footer { padding: 4rem 0 3rem; border-top: 1px solid var(--border); margin-top: 4rem; }
    .footer-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
    .footer-copy { font-size: 0.75rem; color: var(--text-muted); font-family: 'Space Grotesk', sans-serif; text-transform: uppercase; letter-spacing: 0.1em; }
    .footer-links { display: flex; gap: 2rem; }
    .footer-link {
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .footer-link:hover {
      color: var(--accent);
      text-shadow: 0 0 10px var(--accent-glow);
    }

    /* Responsive */
    @media (max-width: 640px) {
      .container { padding: 0 1.25rem; }
      .hero { padding: 4rem 0 3rem; }
      .section { padding: 4rem 0; }
      .footer-content { flex-direction: column; align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <Hero profile={profile} />

      <section class="section">
        <h2 class="section-title">作品</h2>
        <div class="projects-list">
          {projects.map((project) => (
            <Project key={project.id} project={project} />
          ))}
        </div>
      </section>


      <footer class="footer">
        <div class="footer-content">
          <span class="footer-copy">© {new Date().getFullYear()} Eric Cao</span>
          <div class="footer-links">
            <a href="https://github.com/caoergou" class="footer-link" target="_blank" rel="noopener">GitHub</a>
            <a href="https://jike.city/ergou" class="footer-link" target="_blank" rel="noopener">即刻</a>
            <a href="mailto:itsericsmail@gmail.com" class="footer-link">Email</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</body>
</html>
