---
import type { CollectionEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import Project from '../components/Project.astro';
import Thought from '../components/Thought.astro';
import TechCloud from '../components/TechCloud.astro';
import GameEggs from '../components/GameEggs.astro';
import { t, getClientTranslations, getI18nClientScript, getTranslations, type Lang } from '../i18n';

interface Props {
  profile: CollectionEntry<'profile'>;
  projects: CollectionEntry<'projects'>[];
  thoughts: CollectionEntry<'thoughts'>[];
}

const { profile, projects, thoughts } = Astro.props;
const siteUrl = 'https://eric.run.place';

// i18n helper for server-side rendering
const getTranslation = (lang: Lang, key: string) => t(lang, key);

// Get translations for client-side injection
const clientTranslations = getClientTranslations();
const i18nClientScript = getI18nClientScript();

// SSR default content (Chinese) for coming-soon section
const zhComingSoonItems = getTranslations('zh').comingSoon.items;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n="site.title">{getTranslation('zh', 'site.title')}</title>
  <meta name="description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="keywords" content="Eric Cao, Python, AI Agent, Dify, Airflow, 大数据, 开源, TypeScript, React, Full-Stack, Developer">
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">

  <!-- Search Engine Verification -->
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8" />
  <meta name="baidu-site-verification" content="codeva-4Lwu94LneY" />

  <!-- Language -->
  <meta property="og:locale" content="zh_CN" />
  <meta name="language" content="zh-CN" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta property="og:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:image" content={`${siteUrl}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Eric Cao 的个人网站 - Python 开发者与开源贡献者，专注于 AI Agent、大数据、Web 开发">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@caoergou">
  <meta name="twitter:url" content={siteUrl}>
  <meta name="twitter:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta name="twitter:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`}>

  <!-- Canonical URL -->
  <link rel="canonical" href={siteUrl}>

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Eric Cao",
    "alternateName": "caoergou",
    "url": siteUrl,
    "image": `${siteUrl}/avatar.png`,
    "sameAs": [
      "https://github.com/caoergou",
      "https://jike.city/ergou"
    ],
    "jobTitle": "Full-Stack Developer",
    "description": getTranslation('zh', 'site.description'),
    "knowsAbout": ["Python", "TypeScript", "AI Agent", "Dify", "Airflow", "Big Data", "React"],
    "inLanguage": {
      "@type": "Language",
      "name": "Chinese",
      "alternateName": "zh-CN"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "首页",
        "item": siteUrl
      }
    ]
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Pixel fonts for game style -->
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* ===== Simplified Minimal Theme ===== */
    :root {
      /* Core Colors - Simplified to 3 main colors */
      --bg: #1a1f2e;           /* Deep blue-gray */
      --bg-secondary: #252b3d; /* Slightly lighter */
      --surface: #2d3548;      /* Card backgrounds */
      --surface-alt: #363f55;  /* Hover states */
      --border: #4a5568;       /* Subtle borders */
      --border-light: #5a6a7a; /* Light borders */
      --text-primary: #f0f0e8; /* Main text */
      --text-secondary: #a0aec0; /* Secondary text */
      --text-muted: #6b7280;   /* Muted text */

      /* Single accent system */
      --accent: #fbbf24;       /* Amber gold - primary emphasis */
      --accent-secondary: #10b981; /* Emerald green - secondary emphasis */

      /* Simplified shadows */
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -4px rgba(0, 0, 0, 0.2);

      /* Smooth transitions */
      --transition-fast: 0.15s ease;
      --transition-normal: 0.25s ease;
    }

    /* Light Theme - Clean and minimal */
    .light-mode {
      --bg: #fafafa;
      --bg-secondary: #f3f4f6;
      --surface: #ffffff;
      --surface-alt: #f9fafb;
      --border: #e5e7eb;
      --border-light: #d1d5db;
      --text-primary: #1f2937;
      --text-secondary: #4b5563;
      --text-muted: #9ca3af;

      --accent: #d97706;       /* Darker amber for light mode */
      --accent-secondary: #059669; /* Darker green */

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'VT323', monospace;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Pixel fonts utility - kept for personality */
    .pixel-font { font-family: 'Press Start 2P', cursive; }
    .pixel-body { font-family: 'VT323', monospace; }
    .serif { font-family: 'Noto Serif SC', serif; }

    .page {
      position: relative;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ===== Clean Background - No stars/CRT ===== */
    body::before, body::after {
      display: none;
    }

    /* ===== Sections - Clean and simple ===== */
    .section {
      padding: 3rem 0 2rem;
      position: relative;
    }

    /* Simple single-color divider line */
    .section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--border);
    }

    .section-title {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: var(--text-primary);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
      padding-bottom: 0.5rem;
      text-transform: uppercase;
    }

    /* Simple underline instead of colorful gradient */
    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 2rem;
      height: 2px;
      background: var(--accent);
    }

    /* ===== Project List ===== */
    .projects-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* ===== Thoughts List ===== */
    .thoughts-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* ===== Coming Soon Section - Simplified ===== */
    .coming-soon {
      background: var(--surface);
      padding: 1.5rem;
      border-radius: 4px;
      border-left: 3px solid var(--accent-secondary);
    }

    .coming-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .coming-item {
      font-family: 'VT323', monospace;
      font-size: 1.1rem;
      color: var(--text-secondary);
      padding-left: 1.25rem;
      position: relative;
      line-height: 1.5;
    }

    .coming-item::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .coming-item:hover {
      color: var(--text-primary);
    }

    /* ===== Footer - Clean ===== */
    .footer {
      padding: 2rem 0;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-copy {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.45rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .footer-links {
      display: flex;
      gap: 0.75rem;
    }

    .footer-link {
      font-family: 'VT323', monospace;
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-decoration: none;
      cursor: pointer;
      padding: 0.4rem 0.75rem;
      background: var(--surface);
      border-radius: 4px;
      border: 1px solid var(--border);
      transition: all var(--transition-fast);
    }

    .footer-link:hover {
      color: var(--accent);
      border-color: var(--accent);
      background: var(--surface-alt);
    }

    /* Hidden Konami Code hint - simplified */
    .footer-secret {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.3rem;
      color: var(--text-muted);
      margin-top: 1rem;
      text-align: center;
      opacity: 0.25;
      letter-spacing: 0.1em;
      transition: opacity 0.2s ease;
      cursor: default;
    }

    .footer-secret:hover {
      opacity: 0.6;
      color: var(--accent-secondary);
    }

    /* ===== Tech Section ===== */
    .tech-section {
      padding: 1.5rem 0;
    }

    .tech-section::before {
      display: none;
    }

    /* ===== Responsive Design ===== */
    @media (max-width: 768px) {
      .container { padding: 0 1rem; }

      .section { padding: 2rem 0 1.5rem; }
      .section-title { font-size: 0.55rem; }

      .footer-content {
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-copy { font-size: 0.4rem; }
      .footer-link { font-size: 0.85rem; }
    }

    /* ===== Reduced Motion ===== */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ===== Selection Styling ===== */
    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    /* ===== Scrollbar Styling - Simplified ===== */
    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--accent);
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <Hero profile={profile} />

      <section id="skills" class="section tech-section" data-achievement="skills">
        <TechCloud />
      </section>

      <section id="projects" class="section" data-achievement="projects">
        <h2 class="section-title" data-i18n="sections.projects">{getTranslation('zh', 'sections.projects')}</h2>
        <div class="projects-list">
          {projects.map((project) => (
            <Project key={project.id} project={project} />
          ))}
        </div>
      </section>

      <section id="thoughts" class="section" data-achievement="thoughts">
        <h2 class="section-title" data-i18n="sections.explorations">{getTranslation('zh', 'sections.explorations')}</h2>
        <div class="thoughts-list">
          {thoughts.map((thought) => (
            <Thought key={thought.id} thought={thought} />
          ))}
        </div>
      </section>

      <section id="coming" class="section coming-soon" data-achievement="coming">
        <h2 class="section-title" data-i18n="comingSoon.title">{getTranslation('zh', 'comingSoon.title')}</h2>
        <div class="coming-list" id="coming-list">
          {zhComingSoonItems.map((item) => (
            <div class="coming-item">{item}</div>
          ))}
        </div>
      </section>


      <footer class="footer">
        <div class="footer-content">
          <span class="footer-copy">© {new Date().getFullYear()} Eric Cao</span>
          <div class="footer-links">
            <a href="https://github.com/caoergou" class="footer-link" target="_blank" rel="noopener">GitHub</a>
            <a href="https://jike.city/ergou" class="footer-link" target="_blank" rel="noopener">即刻</a>
            <a href="mailto:itsericsmail@gmail.com" class="footer-link">Email</a>
          </div>
        </div>
        <div class="footer-secret" aria-hidden="true" title="↑↑↓↓←→←→BA">🎮 There are secrets here...</div>
      </footer>
    </div>
  </div>

  <!-- 游戏彩蛋系统 -->
  <GameEggs />

  <!-- i18n runtime: translations injected as data-translations attribute -->
  <script is:inline data-translations={clientTranslations} set:html={i18nClientScript} />
</body>
</html>
