---
import type { CollectionEntry } from 'astro:content';
import { t, getClientTranslations, getI18nClientScript, getTranslations, type Lang } from '../i18n';

interface Props {
  profile: CollectionEntry<'profile'>;
  projects: CollectionEntry<'projects'>[];
  thoughts: CollectionEntry<'thoughts'>[];
  posts: { slug: string; date: string; title: { zh: string; en: string }; description: { zh: string; en: string } }[];
}

const { profile, projects, thoughts, posts } = Astro.props;
const siteUrl = 'https://eric.run.place';

// i18n helper for server-side rendering
const getTranslation = (lang: Lang, key: string) => t(lang, key);

// Get translations for client-side injection
const clientTranslations = getClientTranslations();
const i18nClientScript = getI18nClientScript();

// SSR default content (Chinese) for coming-soon section
const zhComingSoonItems = getTranslations('zh').comingSoon.items;

// Navigation items
const navItems = [
  { id: 'about', label: '关于', labelEn: 'About', href: '#about' },
  { id: 'experience', label: '经历', labelEn: 'Experience', href: '#experience' },
  { id: 'projects', label: '项目', labelEn: 'Projects', href: '#projects' },
  { id: 'thoughts', label: '思考', labelEn: 'Thoughts', href: '#thoughts' },
  { id: 'blog', label: '博客', labelEn: 'Blog', href: '/blog/' },
];

// Social links
const socialLinks = [
  { name: 'GitHub', url: 'https://github.com/caoergou', icon: 'github' },
  { name: '即刻', url: 'https://jike.city/ergou', icon: 'jike' },
  { name: 'Email', url: 'mailto:itsericsmail@gmail.com', icon: 'email' },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n="site.title">{getTranslation('zh', 'site.title')}</title>
  <meta name="description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="keywords" content="Eric Cao, Python, AI Agent, Dify, Airflow, 大数据, 开源, TypeScript, React, Full-Stack, Developer">
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">

  <!-- Search Engine Verification -->
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8" />
  <meta name="baidu-site-verification" content="codeva-4Lwu94LneY" />

  <!-- Language -->
  <meta property="og:locale" content="zh_CN" />
  <meta name="language" content="zh-CN" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta property="og:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:image" content={`${siteUrl}/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Eric Cao 的个人网站 - Python 开发者与开源贡献者，专注于 AI Agent、大数据、Web 开发">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@caoergou">
  <meta name="twitter:url" content={siteUrl}>
  <meta name="twitter:title" content={getTranslation('zh', 'site.title')} data-i18n-content="site.title">
  <meta name="twitter:description" content={getTranslation('zh', 'site.description')} data-i18n-content="site.description">
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`}>

  <!-- Canonical URL -->
  <link rel="canonical" href={siteUrl}>

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Eric Cao",
    "alternateName": "caoergou",
    "url": siteUrl,
    "image": `${siteUrl}/avatar.png`,
    "sameAs": [
      "https://github.com/caoergou",
      "https://jike.city/ergou"
    ],
    "jobTitle": "Full-Stack Developer",
    "description": getTranslation('zh', 'site.description'),
    "knowsAbout": ["Python", "TypeScript", "AI Agent", "Dify", "Airflow", "Big Data", "React"],
    "inLanguage": {
      "@type": "Language",
      "name": "Chinese",
      "alternateName": "zh-CN"
    }
  })} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Newsreader:opsz,ital,wght@6..72,0,400..600;6..72,1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style is:global>
    /* ===== CSS Variables - Brittany Chiang Style ===== */
    :root {
      /* Colors */
      --navy: #0a192f;
      --light-navy: #112240;
      --lightest-navy: #233554;
      --navy-shadow: rgba(2, 12, 27, 0.7);
      --dark-slate: #495670;
      --slate: #8892b0;
      --light-slate: #a8b2d1;
      --lightest-slate: #ccd6f6;
      --white: #e6f1ff;
      --green: #64ffda;
      --green-tint: rgba(100, 255, 218, 0.1);
      --pink: #f57dff;
      --blue: #57cbff;

      /* Fonts — serif editorial style */
      --font-display: 'Fraunces', Georgia, 'Songti SC', 'STSong', 'Noto Serif SC', SimSun, serif;
      --font-serif: 'Newsreader', Georgia, 'Times New Roman', 'Songti SC', 'STSong', 'Noto Serif SC', SimSun, serif;
      --font-sans: var(--font-serif);
      --font-mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', 'Roboto Mono', monospace;

      /* Font sizes */
      --fz-xs: 0.75rem;
      --fz-sm: 0.875rem;
      --fz-md: 1rem;
      --fz-lg: 1.125rem;
      --fz-xl: 1.25rem;
      --fz-2xl: 1.5rem;
      --fz-3xl: 2rem;
      --fz-4xl: 2.5rem;
      --fz-5xl: 3rem;

      /* Spacing */
      --spacing-xs: 0.25rem;
      --spacing-sm: 0.5rem;
      --spacing-md: 1rem;
      --spacing-lg: 1.5rem;
      --spacing-xl: 2rem;
      --spacing-2xl: 3rem;
      --spacing-3xl: 4rem;
      --spacing-4xl: 5rem;

      /* Transitions */
      --transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
      --easing: cubic-bezier(0.645, 0.045, 0.355, 1);

      /* Border radius */
      --border-radius: 4px;

      /* Nav height */
      --nav-height: 100px;
      --nav-scroll-height: 70px;
    }

    /* ===== Base Styles ===== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ===== Cursor Spotlight ===== */
    .spotlight {
      position: fixed;
      inset: 0;
      z-index: 30;
      pointer-events: none;
      /* Default centered until first mousemove */
      --spot-x: 50%;
      --spot-y: 0%;
      background: radial-gradient(
        600px circle at var(--spot-x) var(--spot-y),
        rgba(100, 255, 218, 0.07),
        transparent 70%
      );
      will-change: background;
    }

    /* Subtle full-page ambient glow behind everything */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(70% 50% at 15% 0%, rgba(100, 255, 218, 0.05), transparent 60%),
        radial-gradient(60% 50% at 100% 100%, rgba(87, 203, 255, 0.04), transparent 60%);
    }

    @media (hover: none), (prefers-reduced-motion: reduce) {
      .spotlight { display: none; }
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: var(--font-serif);
      background-color: var(--navy);
      color: var(--slate);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-optical-sizing: auto;
    }

    /* ===== Typography ===== */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-display);
      color: var(--lightest-slate);
      font-weight: 600;
      line-height: 1.1;
      font-optical-sizing: auto;
      letter-spacing: -0.01em;
    }

    /* Ligatures for monospace (code-like elements) */
    code, pre, .font-mono,
    .section-number, nav a, .mobile-nav a {
      font-feature-settings: 'liga' 1, 'calt' 1;
    }

    a {
      color: var(--green);
      text-decoration: none;
      transition: var(--transition);
      display: inline-block;
      position: relative;
    }

    a:hover {
      color: var(--green);
    }

    a::after {
      content: '';
      display: block;
      width: 0;
      height: 1px;
      background: var(--green);
      transition: width 0.3s var(--easing);
    }

    a:hover::after {
      width: 100%;
    }

    /* Special links without underline animation */
    .no-underline::after,
    nav a::after,
    .social-links a::after {
      display: none;
    }

    /* ===== Layout ===== */
    .layout {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    @media (min-width: 1024px) {
      .layout {
        flex-direction: row;
      }
    }

    /* Left Side - Sticky Header */
    .header {
      padding: var(--spacing-xl);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background-color: transparent;
    }

    @media (min-width: 1024px) {
      .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 45%;
        height: 100vh;
        max-width: 480px;
        padding: var(--spacing-4xl) var(--spacing-2xl);
      }
    }

    @media (min-width: 1280px) {
      .header {
        padding: var(--spacing-4xl) var(--spacing-3xl);
      }
    }

    /* Right Side - Scrollable Content */
    .main {
      padding: var(--spacing-xl);
    }

    @media (min-width: 1024px) {
      .main {
        margin-left: 45%;
        width: 55%;
        padding: var(--spacing-4xl) var(--spacing-2xl);
        max-width: 900px;
      }
    }

    @media (min-width: 1280px) {
      .main {
        padding: var(--spacing-4xl) var(--spacing-3xl);
      }
    }

    /* ===== Section Styles ===== */
    section {
      margin-bottom: var(--spacing-4xl);
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-2xl);
      font-size: var(--fz-2xl);
      color: var(--lightest-slate);
    }

    .section-number {
      font-family: var(--font-mono);
      font-size: var(--fz-lg);
      color: var(--green);
      font-weight: 400;
    }

    .section-divider {
      flex: 1;
      height: 1px;
      background: var(--lightest-navy);
      max-width: 300px;
    }

    /* ===== Navigation ===== */
    nav {
      display: none;
    }

    @media (min-width: 1024px) {
      nav {
        display: block;
        margin: var(--spacing-2xl) 0;
      }

      nav ul {
        list-style: none;
      }

      nav li {
        margin-bottom: var(--spacing-md);
      }

      nav a {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        color: var(--slate);
        font-family: var(--font-mono);
        font-size: var(--fz-sm);
        padding: var(--spacing-sm) 0;
        transition: var(--transition);
      }

      nav a::before {
        content: '';
        display: block;
        width: 2rem;
        height: 1px;
        background: var(--lightest-navy);
        transition: var(--transition);
      }

      nav a:hover,
      nav a.active {
        color: var(--green);
      }

      nav a:hover::before,
      nav a.active::before {
        width: 3rem;
        background: var(--green);
      }

      nav a span {
        color: var(--green);
        font-size: var(--fz-xs);
        margin-right: var(--spacing-xs);
      }
    }

    /* ===== Social Links ===== */
    .social-links {
      display: flex;
      gap: var(--spacing-lg);
      margin-top: var(--spacing-xl);
    }

    @media (min-width: 1024px) {
      .social-links {
        margin-top: 0;
      }
    }

    .social-links a {
      color: var(--light-slate);
      transition: var(--transition);
    }

    .social-links a:hover {
      color: var(--green);
      transform: translateY(-2px);
    }

    .social-links svg {
      width: 20px;
      height: 20px;
    }

    /* ===== Footer ===== */
    footer {
      padding: var(--spacing-xl) 0;
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fz-xs);
      color: var(--light-slate);
    }

    @media (min-width: 1024px) {
      footer {
        text-align: left;
        padding: var(--spacing-2xl) 0;
      }
    }

    /* ===== Selection ===== */
    ::selection {
      background: var(--lightest-navy);
      color: var(--green);
    }

    /* ===== Scrollbar ===== */
    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: var(--navy);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--lightest-navy);
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--slate);
    }

    /* ===== Reduced Motion ===== */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ===== Mobile Navigation ===== */
    .mobile-nav {
      display: flex;
      gap: var(--spacing-md);
      overflow-x: auto;
      padding-bottom: var(--spacing-sm);
      margin: var(--spacing-lg) 0;
      scrollbar-width: none;
    }

    .mobile-nav::-webkit-scrollbar {
      display: none;
    }

    .mobile-nav a {
      font-family: var(--font-mono);
      font-size: var(--fz-sm);
      color: var(--slate);
      white-space: nowrap;
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius);
    }

    .mobile-nav a:hover,
    .mobile-nav a.active {
      color: var(--green);
      background: var(--green-tint);
    }

    @media (min-width: 1024px) {
      .mobile-nav {
        display: none;
      }
    }

    /* ===== Language Toggle ===== */
    .lang-toggle {
      position: fixed;
      top: var(--spacing-lg);
      right: var(--spacing-lg);
      z-index: 100;
      background: transparent;
      border: 1px solid var(--green);
      color: var(--green);
      font-family: var(--font-mono);
      font-size: var(--fz-xs);
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--border-radius);
      cursor: pointer;
      transition: var(--transition);
    }

    .lang-toggle:hover {
      background: var(--green-tint);
    }
  </style>
</head>
<body>
  <!-- Cursor spotlight (Brittany Chiang style) -->
  <div id="spotlight" class="spotlight" aria-hidden="true"></div>

  <button class="lang-toggle" id="langToggle" aria-label="切换语言">
    <span class="lang-text">EN</span>
  </button>

  <div class="layout">
    <!-- Left Side - Fixed Header -->
    <header class="header">
      <div>
        <h1 style="font-size: var(--fz-4xl); color: var(--lightest-slate); margin-bottom: var(--spacing-sm); font-weight: 700;">
          Eric Cao
        </h1>
        <h2 style="font-size: var(--fz-xl); color: var(--light-slate); margin-bottom: var(--spacing-lg); font-weight: 500;" data-i18n="hero.title">
          大数据与全栈出身，现在专注 AI 怎么落地
        </h2>
        <p style="font-size: var(--fz-lg); color: var(--slate); max-width: 400px; line-height: 1.6;" data-i18n="hero.subtitle">
          大数据工程师出身，做过 Java 与 Python 全栈，也一头扎进过 LLM 应用。如今在认真琢磨：企业怎么用好 AI，哪些工作流真正该被 Agent 改变。
        </p>

        <!-- Desktop Navigation -->
        <nav>
          <ul>
            {navItems.map((item, index) => (
              <li>
                <a href={item.href} class="nav-link">
                  <span>0{index + 1}.</span>
                  <span data-i18n={`nav.${item.id}`}>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Mobile Navigation -->
      <div class="mobile-nav">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link-mobile" data-i18n={`nav.${item.id}`}>
            {item.label}
          </a>
        ))}
      </div>

      <!-- Social Links -->
      <div class="social-links">
        <a href="https://github.com/caoergou" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href="https://jike.city/ergou" target="_blank" rel="noopener noreferrer" aria-label="即刻">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6zm4 4h-2v-2h2v2zm0-4h-2V7h2v6z"/>
          </svg>
        </a>
        <a href="mailto:itsericsmail@gmail.com" aria-label="Email">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- Right Side - Main Content -->
    <main class="main">
      <!-- About Section -->
      <section id="about">
        <div class="section-title">
          <span class="section-number">01.</span>
          <span data-i18n="sections.about">关于</span>
          <span class="section-divider"></span>
        </div>
        <div style="font-size: var(--fz-lg); line-height: 1.8; color: var(--slate);">
          <p style="margin-bottom: var(--spacing-lg);" data-i18n="about.p1">
            我的工程底子是从大数据攒起来的——2021 到 2023 年在即刻做大数据工程师，和 Java、海量数据打交道，那段经历教会我什么是好工程。
          </p>
          <p style="margin-bottom: var(--spacing-lg);" data-i18n="about.p2">
            之后我转向 Python 与全栈开发，也一头扎进 LLM 应用。从后端到产品、从调模型到拼工作流，我越来越确信：开发方式正在被 AI 重新定义。（私下里，我也是个乐在其中的 vibe coder。）
          </p>
          <p data-i18n="about.p3">
            2026 年起，我把重心放在 AI 怎么在企业真正落地——重新考量哪些工作流该被 Agent 改变，也乐于把摸索出来的实践分享给更多人。好的工程从来不是炫技，而是让真正有用的东西被更多人用起来。
          </p>
        </div>
      </section>

      <!-- Experience Section -->
      <section id="experience">
        <div class="section-title">
          <span class="section-number">02.</span>
          <span data-i18n="sections.experience">经历</span>
          <span class="section-divider"></span>
        </div>

        <div class="experience-list">
          <div class="experience-item" style="margin-bottom: var(--spacing-2xl);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--spacing-sm); flex-wrap: wrap; gap: var(--spacing-sm);">
              <h3 style="font-size: var(--fz-xl); color: var(--lightest-slate);" data-i18n="experience.recent.title">专注 AI 工程化落地</h3>
              <span style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--light-slate);" data-i18n="experience.recent.period">2026 — 至今</span>
            </div>
            <p style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--green); margin-bottom: var(--spacing-md);" data-i18n="experience.recent.company">企业 AI 落地 · 工作流改造</p>
            <p style="font-size: var(--fz-md); line-height: 1.7; margin-bottom: var(--spacing-md);" data-i18n="experience.recent.description">
              琢磨 AI 怎么在企业真正落地，评估哪些工作流该被 Agent 改变，并把摸索出的实践分享给团队与社区。
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
              {['AI Agent', 'Claude Code', 'Workflow'].map((tech) => (
                <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--slate); background: var(--green-tint); padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--border-radius);">
                  {tech}
                </span>
              ))}
            </div>
          </div>
          <div class="experience-item" style="margin-bottom: var(--spacing-2xl);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--spacing-sm); flex-wrap: wrap; gap: var(--spacing-sm);">
              <h3 style="font-size: var(--fz-xl); color: var(--lightest-slate);" data-i18n="experience.fullstack.title">Python & 全栈开发者</h3>
              <span style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--light-slate);" data-i18n="experience.fullstack.period">2023 — 2025</span>
            </div>
            <p style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--green); margin-bottom: var(--spacing-md);" data-i18n="experience.fullstack.company">全栈开发 · LLM 应用</p>
            <p style="font-size: var(--fz-md); line-height: 1.7; margin-bottom: var(--spacing-md);" data-i18n="experience.fullstack.description">
              从后端走向全栈，深入 LLM 应用开发，并构建、维护多个开源项目。
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
              {['Python', 'TypeScript', 'LLM', 'React'].map((tech) => (
                <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--slate); background: var(--green-tint); padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--border-radius);">
                  {tech}
                </span>
              ))}
            </div>
          </div>
          <div class="experience-item" style="margin-bottom: var(--spacing-2xl);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--spacing-sm); flex-wrap: wrap; gap: var(--spacing-sm);">
              <h3 style="font-size: var(--fz-xl); color: var(--lightest-slate);" data-i18n="experience.bigdata.title">大数据工程师</h3>
              <span style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--light-slate);" data-i18n="experience.bigdata.period">2021 — 2023</span>
            </div>
            <p style="font-family: var(--font-mono); font-size: var(--fz-sm); color: var(--green); margin-bottom: var(--spacing-md);" data-i18n="experience.bigdata.company">即刻 Jike</p>
            <p style="font-size: var(--fz-md); line-height: 1.7; margin-bottom: var(--spacing-md);" data-i18n="experience.bigdata.description">
              负责大数据平台与海量数据处理，技术栈以 Big Data 与 Java 为主，打下了对复杂系统与好工程的判断力。
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
              {['Big Data', 'Java', 'Data Pipeline'].map((tech) => (
                <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--slate); background: var(--green-tint); padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--border-radius);">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Projects Section -->
      <section id="projects">
        <div class="section-title">
          <span class="section-number">03.</span>
          <span data-i18n="sections.projects">项目</span>
          <span class="section-divider"></span>
        </div>

        <div class="projects-list">
          {projects.map((project, index) => (
            <div class="project-item" style="margin-bottom: var(--spacing-2xl);">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--spacing-sm); flex-wrap: wrap; gap: var(--spacing-sm);">
                <a href={project.data.url} target="_blank" rel="noopener noreferrer" style="font-size: var(--fz-xl); color: var(--lightest-slate); font-weight: 600;">
                  {project.data.title}
                </a>
                <div style="display: flex; gap: var(--spacing-md);">
                  {project.data.demo_url && (
                    <a href={project.data.demo_url} target="_blank" rel="noopener noreferrer" class="no-underline" aria-label="Live Demo">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px;">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  )}
                  {project.data.github && (
                    <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="no-underline" aria-label="GitHub">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 20px; height: 20px;">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
              <p style="font-size: var(--fz-md); line-height: 1.7; margin-bottom: var(--spacing-md); color: var(--slate);"
                 data-desc-zh={project.data.description?.zh}
                 data-desc-en={project.data.description?.en}>
                {project.data.description?.zh}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
                {project.data.technologies?.map((tech: string) => (
                  <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--slate);">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Thoughts Section -->
      <section id="thoughts">
        <div class="section-title">
          <span class="section-number">04.</span>
          <span data-i18n="sections.thoughts">思考</span>
          <span class="section-divider"></span>
        </div>

        <div class="thoughts-list">
          {thoughts.map((thought) => (
            <div class="thought-item" style="margin-bottom: var(--spacing-xl);">
              <h3 style="font-size: var(--fz-lg); color: var(--lightest-slate); font-weight: 500; margin-bottom: var(--spacing-xs);"
                 data-title-zh={thought.data.title?.zh}
                 data-title-en={thought.data.title?.en}>
                {thought.data.title?.zh}
              </h3>
              <p style="font-size: var(--fz-sm); color: var(--slate); line-height: 1.6; margin-bottom: var(--spacing-sm);"
                 data-desc-zh={thought.data.description?.zh || thought.data.excerpt?.zh}
                 data-desc-en={thought.data.description?.en || thought.data.excerpt?.en}>
                {thought.data.description?.zh || thought.data.excerpt?.zh}
              </p>
              <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--dark-slate);">
                {new Date(thought.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- Blog Section -->
      <section id="blog">
        <div class="section-title">
          <span class="section-number">05.</span>
          <span data-i18n="nav.blog">博客</span>
          <span class="section-divider"></span>
        </div>

        <div class="thoughts-list">
          {posts.map((post) => (
            <div class="thought-item" style="margin-bottom: var(--spacing-xl);">
              <a href={`/blog/zh/${post.slug}`} data-blog-link data-slug={post.slug} style="font-size: var(--fz-lg); color: var(--lightest-slate); font-weight: 500; margin-bottom: var(--spacing-xs); display: block;"
                 data-title-zh={post.title.zh}
                 data-title-en={post.title.en}>
                {post.title.zh}
              </a>
              <p style="font-size: var(--fz-sm); color: var(--slate); line-height: 1.6; margin-bottom: var(--spacing-sm);"
                 data-desc-zh={post.description.zh}
                 data-desc-en={post.description.en}>
                {post.description.zh}
              </p>
              <span style="font-family: var(--font-mono); font-size: var(--fz-xs); color: var(--dark-slate);">
                {post.date}
              </span>
            </div>
          ))}
        </div>
      </section>

      <footer>
        <p style="margin-bottom: var(--spacing-sm);">
          Built with Astro & inspired by <a href="https://brittanychiang.com" target="_blank" rel="noopener noreferrer">Brittany Chiang</a>
        </p>
        <p>© {new Date().getFullYear()} Eric Cao. All rights reserved.</p>
      </footer>
    </main>
  </div>

  <!-- i18n runtime -->
  <script is:inline data-translations={clientTranslations} set:html={i18nClientScript} />

  <script is:inline>
    // Smooth scroll for navigation links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Active nav link highlighting
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link, .nav-link-mobile');

    function highlightNav() {
      const scrollPos = window.scrollY + 200;

      sections.forEach((section, index) => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;

        if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
          navLinks.forEach(link => link.classList.remove('active'));
          const activeLink = document.querySelectorAll('.nav-link')[index];
          const activeLinkMobile = document.querySelectorAll('.nav-link-mobile')[index];
          if (activeLink) activeLink.classList.add('active');
          if (activeLinkMobile) activeLinkMobile.classList.add('active');
        }
      });
    }

    window.addEventListener('scroll', highlightNav);
    highlightNav();

    // Language toggle
    const langToggle = document.getElementById('langToggle');
    const langText = langToggle.querySelector('.lang-text');

    langToggle.addEventListener('click', () => {
      const currentLang = localStorage.getItem('lang') || 'zh';
      const newLang = currentLang === 'zh' ? 'en' : 'zh';
      localStorage.setItem('lang', newLang);

      // Update button text
      langText.textContent = newLang === 'zh' ? 'EN' : '中';

      // Update all i18n elements
      if (window.__I18N__) {
        window.__I18N__.updateAllText(newLang);
      }
    });

    // Initialize language button
    const savedLang = localStorage.getItem('lang') || 'zh';
    langText.textContent = savedLang === 'zh' ? 'EN' : '中';

    // Update blog post links based on language
    function updateBlogLinks(lang) {
      document.querySelectorAll('[data-blog-link]').forEach(el => {
        const slug = el.getAttribute('data-slug');
        if (slug) el.setAttribute('href', `/blog/${lang}/${slug}`);
      });
    }
    updateBlogLinks(savedLang);
    window.addEventListener('langChange', (e) => updateBlogLinks(e.detail.lang));

    // Cursor spotlight — smooth lerp follow
    (function () {
      const spot = document.getElementById('spotlight');
      if (!spot) return;
      const noHover = window.matchMedia('(hover: none)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (noHover || reduced) return;

      let targetX = window.innerWidth / 2;
      let targetY = 0;
      let curX = targetX;
      let curY = targetY;
      let raf = null;

      function tick() {
        curX += (targetX - curX) * 0.14;
        curY += (targetY - curY) * 0.14;
        spot.style.setProperty('--spot-x', curX + 'px');
        spot.style.setProperty('--spot-y', curY + 'px');
        if (Math.abs(targetX - curX) > 0.5 || Math.abs(targetY - curY) > 0.5) {
          raf = requestAnimationFrame(tick);
        } else {
          raf = null;
        }
      }

      window.addEventListener('mousemove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
        if (raf === null) raf = requestAnimationFrame(tick);
      }, { passive: true });
    })();
  </script>
</body>
</html>
