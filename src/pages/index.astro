---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const [profile, projects, thoughts, allPosts] = await Promise.all([
  getCollection('profile'),
  getCollection('projects'),
  getCollection('thoughts'),
  getCollection('posts'),
]);

// 配对 zh/en 博客文章，供首页博客区双语展示
const enPosts = allPosts.filter((p) => p.id.startsWith('en/'));
const posts = allPosts
  .filter((p) => p.id.startsWith('zh/'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((zh) => {
    const slug = zh.id.replace('zh/', '');
    const en = enPosts.find((e) => e.id === `en/${slug}`);
    return {
      slug,
      date: zh.data.date,
      title: { zh: zh.data.title, en: en?.data.title ?? zh.data.title },
      description: { zh: zh.data.description, en: en?.data.description ?? zh.data.description },
    };
  });
---

<BaseLayout
  profile={profile[0]}
  projects={projects}
  thoughts={thoughts}
  posts={posts}
/>
