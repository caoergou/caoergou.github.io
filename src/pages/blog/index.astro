---
// Blog page - Pixel Adventure Style
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>博客 - Eric Cao</title>
  <meta name="description" content="分享我的思考和技术文章">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    /* ===== Pixel Game Theme ===== */
    :root {
      --bg: #1a1a2e;
      --bg-secondary: #16213e;
      --surface: #2d3a4f;
      --surface-alt: #3d4a5f;
      --border: #5a6a7a;
      --border-light: #7a8a9a;
      --text-primary: #f0f0e8;
      --text-secondary: #a8b8c8;
      --text-muted: #6a7a8a;
      --accent: #ffd93d;
      --accent-2: #6bcb77;
      --accent-3: #4d96ff;
      --accent-4: #ff6b6b;
      --accent-5: #c9b1ff;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'VT323', monospace;
      background: var(--bg);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: none;
      image-rendering: pixelated;
    }

    /* Pixel star background */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      background-color: var(--bg);
      background-image:
        radial-gradient(1px 1px at 10% 20%, var(--accent) 50%, transparent 50%),
        radial-gradient(1px 1px at 30% 50%, var(--accent-2) 50%, transparent 50%),
        radial-gradient(1px 1px at 50% 10%, var(--accent-3) 50%, transparent 50%),
        radial-gradient(2px 2px at 70% 40%, var(--accent-5) 50%, transparent 50%),
        radial-gradient(2px 2px at 90% 60%, var(--accent) 50%, transparent 50%);
      animation: twinkle 8s ease-in-out infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ===== Navigation ===== */
    .nav {
      padding: 1.5rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Press Start 2P', cursive;
      font-size: 0.5rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.4rem 0.6rem;
      background: var(--surface);
      box-shadow:
        2px 0 0 var(--border),
        -2px 0 0 var(--border),
        0 2px 0 var(--border),
        0 -2px 0 var(--border);
      transition: all 0.15s step-end;
    }

    .nav-back:hover {
      color: var(--accent);
      box-shadow:
        2px 0 0 var(--accent),
        -2px 0 0 var(--accent),
        0 2px 0 var(--accent),
        0 -2px 0 var(--accent);
    }

    .nav-sep {
      color: var(--text-muted);
      font-family: 'VT323', monospace;
      font-size: 1rem;
    }

    .nav-current {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: var(--text-secondary);
    }

    /* ===== Header ===== */
    .page-header {
      padding: 2rem 0 2.5rem;
      border-bottom: 4px solid var(--border);
    }

    .page-title {
      font-family: 'Press Start 2P', cursive;
      font-size: clamp(1.2rem, 4vw, 1.6rem);
      color: var(--accent);
      margin-bottom: 0.5rem;
      text-shadow: 3px 3px 0 var(--bg-secondary);
    }

    .page-desc {
      font-family: 'VT323', monospace;
      font-size: 1.1rem;
      color: var(--text-secondary);
    }

    /* ===== Post List ===== */
    .post-list {
      display: flex;
      flex-direction: column;
      padding: 1rem 0;
    }

    .post-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      padding: 1rem;
      margin-bottom: 0.5rem;
      background: var(--surface);
      box-shadow:
        3px 0 0 var(--border),
        -3px 0 0 var(--border),
        0 3px 0 var(--border),
        0 -3px 0 var(--border);
      text-decoration: none;
      color: inherit;
      transition: all 0.15s step-end;
    }

    .post-item:hover {
      transform: translate(-2px, -2px);
      box-shadow:
        5px 0 0 var(--accent),
        -5px 0 0 var(--accent),
        0 5px 0 var(--accent),
        0 -5px 0 var(--accent);
    }

    .post-item:hover .post-title {
      color: var(--accent);
    }

    .post-title {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.55rem;
      color: var(--text-primary);
      transition: color 0.15s step-end;
    }

    .post-date {
      font-family: 'VT323', monospace;
      font-size: 0.95rem;
      color: var(--text-muted);
      white-space: nowrap;
    }

    /* ===== Empty State ===== */
    .empty {
      padding: 3rem 0;
      text-align: center;
    }

    .empty-title {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.65rem;
      color: var(--text-secondary);
      margin-bottom: 0.75rem;
    }

    .empty-desc {
      font-family: 'VT323', monospace;
      font-size: 1.1rem;
      color: var(--text-muted);
    }

    .empty-icon {
      font-size: 2rem;
      margin-bottom: 1rem;
      animation: float 2s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    /* ===== Footer ===== */
    .footer {
      padding: 2rem 0;
      border-top: 4px solid var(--border);
      margin-top: 2rem;
    }

    .footer-copy {
      font-family: 'Press Start 2P', cursive;
      font-size: 0.45rem;
      color: var(--text-muted);
    }

    /* ===== Responsive ===== */
    @media (max-width: 640px) {
      .container { padding: 0 1rem; }
      .post-item {
        flex-direction: column;
        gap: 0.25rem;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <nav class="nav">
        <a href="/" class="nav-back">
          <span>◄</span>
          <span>首页</span>
        </a>
        <span class="nav-sep">|</span>
        <span class="nav-current">博客</span>
      </nav>

      <header class="page-header">
        <h1 class="page-title">📜 博客</h1>
        <p class="page-desc">Python · 分布式系统 · Web 开发 · AI 应用</p>
      </header>

      <main class="post-list">
        <div class="empty">
          <div class="empty-icon">🗺️</div>
          <p class="empty-title">新地图正在绘制中...</p>
          <p class="empty-desc">探险日志即将解锁，敬请期待。</p>
        </div>
      </main>

      <footer class="footer">
        <span class="footer-copy">© 2026 Eric Cao</span>
      </footer>
    </div>
  </div>
</body>
</html>
