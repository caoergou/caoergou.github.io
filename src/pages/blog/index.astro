---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => post.id.startsWith('zh/'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>博客 - Eric Cao</title>
  <meta name="description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。">
  <meta name="keywords" content="Eric Cao, 博客, Python, AI Agent, Dify, Airflow, 大数据, 分布式系统, Web 开发, 技术博客">
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow">

  <!-- Canonical URL -->
  <link rel="canonical" href="https://eric.run.place/blog/">

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://eric.run.place/blog/">
  <meta property="og:title" content="博客 - Eric Cao">
  <meta property="og:description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。">
  <meta property="og:image" content="https://eric.run.place/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="博客 - Eric Cao">
  <meta name="twitter:description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。">
  <meta name="twitter:image" content="https://eric.run.place/og-image.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"></noscript>
  <style>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    :root {
      --navy: #0a192f;
      --light-navy: #112240;
      --lightest-navy: #233554;
      --dark-slate: #495670;
      --slate: #8892b0;
      --light-slate: #a8b2d1;
      --lightest-slate: #ccd6f6;
      --green: #64ffda;
      --green-tint: rgba(100, 255, 218, 0.1);

      --bg: var(--navy);
      --surface: var(--light-navy);
      --surface-hover: var(--lightest-navy);
      --border: rgba(100, 255, 218, 0.1);
      --text-primary: var(--lightest-slate);
      --text-secondary: var(--slate);
      --text-muted: var(--dark-slate);
      --accent: var(--green);

      --font-display: 'Fraunces', Georgia, 'Songti SC', 'STSong', 'Noto Serif SC', SimSun, serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
      --font-mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--navy);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(70% 50% at 15% 0%, rgba(100, 255, 218, 0.05), transparent 60%),
        radial-gradient(60% 50% at 100% 100%, rgba(87, 203, 255, 0.04), transparent 60%);
    }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Nav ── */
    .nav {
      padding: 2rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .nav-back:hover { color: var(--accent); }

    .nav-sep {
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .nav-current {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    /* ── Header ── */
    .page-header {
      padding: 3rem 0 3.5rem;
      border-bottom: 1px solid var(--border);
    }

    .page-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 2.6rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--lightest-slate);
      margin-bottom: 0.5rem;
    }

    .page-desc {
      font-size: 0.95rem;
      color: var(--text-secondary);
      font-weight: 300;
    }

    /* ── Post list ── */
    .post-list {
      display: flex;
      flex-direction: column;
      padding: 1rem 0;
    }

    .post-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }

    .post-item:hover .post-title { color: var(--accent); }

    .post-title {
      font-size: 0.95rem;
      color: var(--text-primary);
      font-weight: 400;
      transition: color 0.2s ease;
    }

    .post-date {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    /* ── Empty state ── */
    .empty {
      padding: 4rem 0;
      text-align: center;
    }

    .empty-title {
      font-size: 1rem;
      color: var(--text-secondary);
      font-weight: 400;
      margin-bottom: 0.5rem;
    }

    .empty-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      font-weight: 300;
    }

    /* ── Footer ── */
    .footer {
      padding: 3rem 0;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    @media (max-width: 640px) {
      .container { padding: 0 1.25rem; }
      .post-item { flex-direction: column; gap: 0.2rem; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <nav class="nav">
        <a href="/" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          首页
        </a>
        <span class="nav-sep">/</span>
        <span class="nav-current">博客</span>
      </nav>

      <header class="page-header">
        <h1 class="page-title">博客</h1>
        <p class="page-desc">Python · 分布式系统 · Web 开发 · AI 应用</p>
      </header>

      <main class="post-list">
        {posts.length === 0 ? (
          <div class="empty">
            <p class="empty-title">文章正在路上</p>
            <p class="empty-desc">持续更新中，敬请期待。</p>
          </div>
        ) : (
          posts.map(post => (
            <a href={`/blog/${post.id.replace('zh/', '')}`} class="post-item">
              <span class="post-title">{post.data.title}</span>
              <span class="post-date">{post.data.date}</span>
            </a>
          ))
        )}
      </main>

      <footer class="footer">
        <span class="footer-copy">© 2026 Eric Cao</span>
      </footer>
    </div>
  </div>
</body>
</html>
