---
import { getCollection } from 'astro:content';
import { getClientTranslations, getI18nClientScript } from '../../i18n';

const allPosts = await getCollection('posts');
const enPosts = allPosts.filter(p => p.id.startsWith('en/'));
const posts = allPosts
  .filter(p => p.id.startsWith('zh/'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(zh => {
    const slug = zh.id.replace('zh/', '');
    const en = enPosts.find(e => e.id === `en/${slug}`);
    return {
      slug,
      date: zh.data.date,
      title: { zh: zh.data.title, en: en?.data.title ?? zh.data.title },
      description: { zh: zh.data.description, en: en?.data.description ?? zh.data.description },
    };
  });

const clientTranslations = getClientTranslations();
const i18nClientScript = getI18nClientScript();
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n-title="blog">博客 - Eric Cao</title>
  <meta name="description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。" data-i18n-content="site.description">
  <meta name="keywords" content="Eric Cao, 博客, Python, AI Agent, Dify, Airflow, 大数据, 分布式系统, Web 开发, 技术博客">
  <meta name="author" content="Eric Cao">
  <meta name="robots" content="index, follow">
  <meta name="google-site-verification" content="XuYZmP0E0M5Day61XIADItGmZMHKZ4kIHaHpnbEHtf8">

  <link rel="canonical" href="https://eric.run.place/blog/">
  <link rel="alternate" hreflang="zh-CN" href="https://eric.run.place/blog/">
  <link rel="alternate" hreflang="en-US" href="https://eric.run.place/blog/">
  <link rel="alternate" hreflang="x-default" href="https://eric.run.place/blog/">
  <link rel="alternate" type="application/rss+xml" title="Eric Cao Blog RSS" href="/rss.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://eric.run.place/blog/">
  <meta property="og:title" content="博客 - Eric Cao">
  <meta property="og:description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。">
  <meta property="og:image" content="https://eric.run.place/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Eric Cao">
  <meta property="og:locale" content="zh_CN">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="博客 - Eric Cao">
  <meta name="twitter:description" content="Eric Cao 的技术博客，分享 Python、AI Agent、大数据工程、系统性能优化等方向的实战经验与思考。">
  <meta name="twitter:image" content="https://eric.run.place/og-image.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"></noscript>
  <style>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    :root {
      --navy: #0a192f;
      --light-navy: #112240;
      --lightest-navy: #233554;
      --dark-slate: #495670;
      --slate: #8892b0;
      --light-slate: #a8b2d1;
      --lightest-slate: #ccd6f6;
      --green: #64ffda;
      --green-tint: rgba(100, 255, 218, 0.1);

      --bg: var(--navy);
      --surface: var(--light-navy);
      --surface-hover: var(--lightest-navy);
      --border: rgba(100, 255, 218, 0.1);
      --text-primary: var(--lightest-slate);
      --text-secondary: var(--slate);
      --text-muted: var(--dark-slate);
      --accent: var(--green);

      --font-display: 'Fraunces', Georgia, 'Songti SC', 'STSong', 'Noto Serif SC', SimSun, serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
      --font-mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--navy);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(70% 50% at 15% 0%, rgba(100, 255, 218, 0.05), transparent 60%),
        radial-gradient(60% 50% at 100% 100%, rgba(87, 203, 255, 0.04), transparent 60%);
    }

    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Nav ── */
    .nav {
      padding: 2rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .nav-back:hover { color: var(--accent); }

    .nav-sep {
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .nav-current {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    /* ── Language toggle ── */
    .lang-toggle {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 100;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: rgba(10, 25, 47, 0.85);
      backdrop-filter: blur(8px);
      color: var(--accent);
      font-size: 0.75rem;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .lang-toggle:hover {
      background: var(--green-tint);
      border-color: var(--accent);
    }

    /* ── Header ── */
    .page-header {
      padding: 3rem 0 3.5rem;
      border-bottom: 1px solid var(--border);
    }

    .page-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 2.6rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--lightest-slate);
      margin-bottom: 0.5rem;
    }

    .page-desc {
      font-size: 0.95rem;
      color: var(--text-secondary);
      font-weight: 300;
    }

    /* ── Post list ── */
    .post-list {
      display: flex;
      flex-direction: column;
      padding: 1rem 0;
    }

    .post-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }

    .post-item:hover .post-title { color: var(--accent); }

    .post-title {
      font-size: 0.95rem;
      color: var(--text-primary);
      font-weight: 400;
      transition: color 0.2s ease;
    }

    .post-date {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    /* ── Empty state ── */
    .empty {
      padding: 4rem 0;
      text-align: center;
    }

    .empty-title {
      font-size: 1rem;
      color: var(--text-secondary);
      font-weight: 400;
      margin-bottom: 0.5rem;
    }

    .empty-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      font-weight: 300;
    }

    /* ── Footer ── */
    .footer {
      padding: 3rem 0;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    @media (max-width: 640px) {
      .container { padding: 0 1.25rem; }
      .post-item { flex-direction: column; gap: 0.2rem; }
      .lang-toggle { top: 1rem; right: 1rem; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="container">
      <button class="lang-toggle" id="langToggle" aria-label="切换语言">
        <span class="lang-text">EN</span>
      </button>

      <nav class="nav">
        <a href="/" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span data-i18n="nav.home">首页</span>
        </a>
        <span class="nav-sep">/</span>
        <span class="nav-current" data-i18n="nav.blog">博客</span>
      </nav>

      <header class="page-header">
        <h1 class="page-title" data-i18n="blog.title">博客</h1>
        <p class="page-desc" data-i18n="blog.description">Python · 分布式系统 · Web 开发 · AI 应用</p>
      </header>

      <main class="post-list">
        {posts.length === 0 ? (
          <div class="empty">
            <p class="empty-title" data-i18n="blog.emptyTitle">文章准备中...</p>
            <p class="empty-desc" data-i18n="blog.emptyDesc">新内容即将上线，敬请期待。</p>
          </div>
        ) : (
          posts.map(post => (
            <a href={`/blog/zh/${post.slug}`} class="post-item" data-slug={post.slug}>
              <span class="post-title"
                    data-title-zh={post.title.zh}
                    data-title-en={post.title.en}>
                {post.title.zh}
              </span>
              <span class="post-date">{post.date}</span>
            </a>
          ))
        )}
      </main>

      <footer class="footer">
        <span class="footer-copy">© 2026 Eric Cao</span>
      </footer>
    </div>
  </div>

  <script is:inline data-translations={clientTranslations} set:html={i18nClientScript} />
  <script is:inline>
    function updateBlogListing(lang) {
      document.querySelectorAll('.post-item[data-slug]').forEach(function(el) {
        var slug = el.getAttribute('data-slug');
        el.setAttribute('href', '/blog/' + lang + '/' + slug);
      });
      document.querySelectorAll('[data-title-zh]').forEach(function(el) {
        var text = el.getAttribute('data-title-' + lang);
        if (text) el.textContent = text;
      });
    }

    var langToggle = document.getElementById('langToggle');
    var langText = langToggle.querySelector('.lang-text');

    langToggle.addEventListener('click', function() {
      var currentLang = localStorage.getItem('lang') || 'zh';
      var newLang = currentLang === 'zh' ? 'en' : 'zh';
      localStorage.setItem('lang', newLang);
      langText.textContent = newLang === 'zh' ? 'EN' : '中';
      if (window.__I18N__) window.__I18N__.updateAllText(newLang);
      updateBlogListing(newLang);
    });

    var savedLang = localStorage.getItem('lang') || 'zh';
    langText.textContent = savedLang === 'zh' ? 'EN' : '中';
    document.addEventListener('DOMContentLoaded', function() {
      if (window.__I18N__) window.__I18N__.updateAllText(savedLang);
      updateBlogListing(savedLang);
    });
  </script>
</body>
</html>
